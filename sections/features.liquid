<!-- Features Section -->
<section id="features" class="features-section py-20">
  <div class="max-w-7xl mx-auto px-8">
    <!-- Section Title -->
    <div class="text-center mb-20">
      <h2 class="features-section__heading">Why Choose PrintOra?</h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      
      <!-- Feature 1: Premium Quality Printing -->
      <div class="feature-card bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="feature-card__image-container bg-white p-8 flex items-center justify-center">
          {%- comment -%} 將圖片放到 assets/ 目錄，檔名改為 feature1-premium-quality.jpg {%- endcomment -%}
          {%- assign feature1_image_name = 'feature1-premium-quality.jpg' -%}
          <div class="relative w-full feature-card__image-wrapper">
            <img
              src="{{ feature1_image_name | asset_url }}"
              alt="Premium Quality Printing"
              class="feature-card__image rounded-2xl"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            >
            <div class="w-full h-64 bg-gray-200 rounded-lg flex items-center justify-center" style="display:none;">
              <span class="text-gray-400">Premium Quality Image</span>
            </div>
          </div>
        </div>
        
        <div class="feature-card__content p-6">
          <div class="feature-card__badge feature-card__badge--green mb-4">
            Premium Quality
          </div>
          
          <p class="feature-card__description text-black">
            State-of-the-art DTF printing technology ensures vibrant colors and long-lasting designs that won't fade or crack.
          </p>
        </div>
      </div>
      
      <!-- Feature 2: Fast Shipping -->
      <div class="feature-card bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="feature-card__image-container bg-white p-8 flex items-center justify-center">
          {%- comment -%} 將圖片放到 assets/ 目錄，檔名改為 feature2-fast-shipping.jpg {%- endcomment -%}
          {%- assign feature2_image_name = 'feature2-fast-shipping.jpg' -%}
          <div class="relative w-full feature-card__image-wrapper">
            <img
              src="{{ feature2_image_name | asset_url }}"
              alt="Fast Shipping"
              class="feature-card__image rounded-2xl"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            >
            <div class="w-full h-64 bg-gray-200 rounded-lg flex items-center justify-center" style="display:none;">
              <span class="text-gray-400">Fast Shipping Image</span>
            </div>
          </div>
        </div>
        
        <div class="feature-card__content p-6">
          <div class="feature-card__badge feature-card__badge--pink mb-4">
            Fast Shipping
          </div>
          
          <p class="feature-card__description text-black">
            Quick turnaround times with reliable delivery across New Zealand. Get your custom tees in just 7-10 working days.
          </p>
        </div>
      </div>
      
      <!-- Feature 3: Custom Design -->
      <div class="feature-card bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="feature-card__image-container bg-white p-8 flex items-center justify-center">
          {%- comment -%} 將圖片放到 assets/ 目錄，檔名改為 feature3-custom-design.jpg {%- endcomment -%}
          {%- assign feature3_image_name = 'feature3-custom-design.jpg' -%}
          <div class="relative w-full feature-card__image-wrapper">
            <img
              src="{{ feature3_image_name | asset_url }}"
              alt="Custom Design"
              class="feature-card__image rounded-2xl"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            >
            <div class="w-full h-64 bg-gray-200 rounded-lg flex items-center justify-center" style="display:none;">
              <span class="text-gray-400">Custom Design Image</span>
            </div>
          </div>
        </div>
        
        <div class="feature-card__content p-6">
          <div class="feature-card__badge feature-card__badge--yellow mb-4">
            Custom Design
          </div>
          
          <p class="feature-card__description text-black">
            Upload your own artwork or work with our design team to create something unique that perfectly represents your vision.
          </p>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  .features-section {
    background: linear-gradient(to right, #E0F2FE 0%, #FFFFFF 50%, #FCE7F3 100%);
    padding: 5rem 0;
  }
  
  .features-section__heading {
    font-size: 3.6rem;
    font-weight: 700;
    color: #88D4AB;
    margin: 0;
    font-family: var(--font-primary--family, 'Inter', sans-serif);
  }
  
  @media screen and (max-width: 767px) {
    .features-section__heading {
      font-size: 2.8rem;
    }
  }
  
  .feature-card {
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .feature-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
  }
  
  .feature-card__image-container {
    height: 400px;
    background-color: #FFFFFF;
    overflow: hidden;
    padding: 1.5rem;
  }
  
  .feature-card__image-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .feature-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1.6rem;
  }
  
  @media screen and (max-width: 767px) {
    .feature-card__image-container {
      height: 300px;
      padding: 1rem;
    }
  }
  
  .feature-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }
  
  .feature-card__badge {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 1rem;
    font-size: 1.6rem;
    font-weight: 600;
    color: #1F2937;
    width: fit-content;
    border: 2px solid #1F2937;
  }
  
  .feature-card__badge--green {
    background-color: #D1FAE5;
  }
  
  .feature-card__badge--pink {
    background-color: #FCE7F3;
  }
  
  .feature-card__badge--yellow {
    background-color: #FEF3C7;
  }
  
  .feature-card__description {
    font-size: 1.6rem;
    line-height: 1.6;
    color: #1F2937;
    margin: 0;
  }
  
  @media screen and (max-width: 767px) {
    .features-section {
      padding: 3rem 0;
    }
    
    .feature-card {
      margin-bottom: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Features"
}
{% endschema %}

