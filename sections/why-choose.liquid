{% comment %}
  Why Choose PrintOra Section
  Highlights the benefits and advantages
{% endcomment %}

<section id="why-choose" class="why-choose-section py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl font-black text-deep-gray mb-4">Why Choose PrintOra?</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Professional printing technology and exceptional service
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <!-- Quality -->
      <div class="why-choose-card">
        <div class="why-choose-card__icon">
          <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
        </div>
        <h3 class="why-choose-card__title">Premium Quality</h3>
        <p class="why-choose-card__description">
          High-quality DTF printing technology ensures vibrant colors and durable designs
        </p>
      </div>

      <!-- Fast Production -->
      <div class="why-choose-card">
        <div class="why-choose-card__icon">
          <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="why-choose-card__title">Fast Production</h3>
        <p class="why-choose-card__description">
          Quick turnaround times without compromising on quality
        </p>
      </div>

      <!-- Customer Service -->
      <div class="why-choose-card">
        <div class="why-choose-card__icon">
          <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <h3 class="why-choose-card__title">Expert Support</h3>
        <p class="why-choose-card__description">
          Dedicated customer service team ready to help with your design needs
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .why-choose-section {
    background-color: #F9FAFB;
  }

  .why-choose-card {
    background: white;
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
  }

  .why-choose-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .why-choose-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: #FFB6C1;
  }

  .why-choose-card__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1F2937;
    margin-bottom: 1rem;
  }

  .why-choose-card__description {
    color: #6B7280;
    line-height: 1.6;
  }

  @media screen and (max-width: 768px) {
    .why-choose-card {
      margin-bottom: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Why Choose PrintOra"
}
{% endschema %}
