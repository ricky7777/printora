<!-- Hero Section -->
<section id="hero" class="relative bg-mint min-h-screen flex items-center overflow-hidden hero-section">
  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-8 py-32 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left Content -->
      <div class="space-y-8">
        <!-- Small Title -->
        <div class="text-deep-gray font-light text-sm tracking-[0.3em] uppercase">
          
        </div>
        
        <!-- Main Title -->
        <h1 class="text-6xl lg:text-7xl font-black text-deep-gray leading-tight">
          Your Design<br>
          <span class="text-deep-gray">Your Rules</span>
        </h1>
        
        <!-- Description -->
        <p class="hero-description">
          Professional printing technology that perfectly brings your creative designs to life. 
          From concept to finished product, we're here to make every idea a reality.
        </p>
        
        <!-- CTA Button -->
        <div class="pt-8">
          <a href="#pricing-cards" class="hero-cta-button scroll-to-pricing">
            <span>Upload Your Design</span>
            <svg class="hero-cta-button__arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Right Side - Image -->
      <div class="hidden lg:flex items-center justify-center">
        <div class="relative w-full max-w-lg">
          <img
            src="{{ 'hero-dtf.jpg' | asset_url }}"
            alt="DTF Printing Technology - Professional custom T-shirt printing in New Zealand"
            class="w-full h-auto rounded-2xl shadow-2xl object-cover"
            loading="eager"
            fetchpriority="high"
            width="800"
            height="600"
          >
        </div>
      </div>
    </div>
  </div>
  
  <!-- Curved Bottom -->
  <div class="absolute bottom-0 left-0 w-full h-16 hero-curve hero-curve-bg"></div>
  
  <!-- Scroll Down Hint -->
  <a href="#pricing-cards" class="hero-scroll-hint scroll-to-pricing">
    <div class="hero-scroll-hint__icon">
      <svg class="hero-scroll-hint__arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </a>
</section>

<script>
  // Shared scroll to pricing method
  function scrollToPricing(e) {
    e.preventDefault();
    const target = document.getElementById('pricing-cards');
    if (target) {
      const targetPosition = target.getBoundingClientRect().top + window.pageYOffset;
      const offset = targetPosition * 0.05;
      window.scrollTo({ top: targetPosition - offset, behavior: 'smooth' });
    }
  }
  
  // Attach event listeners when DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    const pricingLinks = document.querySelectorAll('.scroll-to-pricing');
    pricingLinks.forEach(link => {
      link.addEventListener('click', scrollToPricing);
    });
  });
</script>

<style>
  /* Hero Section 背景色 - 已在 theme.liquid 中統一設定，使用 --color-header-hero-bg */
  .hero-section img {
    max-width: 100%;
    height: auto;
  }
  
  /* Hero 底部曲線區塊使用統一的背景色 */
  .hero-curve-bg {
    background-color: var(--color-header-hero-bg);
  }
  
  /* Hero Description - 強化描述文字 */
  .hero-description {
    font-size: 1rem;
    font-weight: 400;
    color: #1F2937;
    line-height: 1.7;
    max-width: 600px;
    letter-spacing: -0.01em;
  }
  
  /* Hero CTA Button - 強化按鈕 */
  .hero-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.96rem;
    background-color: #FFB6C1;
    color: #FFFFFF;
    font-size: 1.44rem;
    font-weight: 700;
    padding: 1.28rem 2.56rem;
    border-radius: 1.92rem;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(255, 182, 193, 0.4), 0 4px 12px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
    letter-spacing: 0.02em;
  }
  
  .hero-cta-button:hover {
    background-color: #FF9FB5;
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(255, 182, 193, 0.5), 0 6px 16px rgba(0, 0, 0, 0.2);
  }
  
  .hero-cta-button:active {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(255, 182, 193, 0.4), 0 3px 10px rgba(0, 0, 0, 0.15);
  }
  
  .hero-cta-button__arrow {
    width: 1.92rem;
    height: 1.92rem;
    transition: transform 0.3s ease;
  }
  
  .hero-cta-button:hover .hero-cta-button__arrow {
    transform: translateX(4px);
  }
  
  @media screen and (max-width: 1023px) {
    .hero-description {
      font-size: 0.8rem;
      max-width: 100%;
    }
    
    .hero-cta-button {
      font-size: 1.2rem;
      padding: 1.12rem 2.24rem;
    }
    
    .hero-cta-button__arrow {
      width: 1.6rem;
      height: 1.6rem;
    }
  }
  
  @media screen and (max-width: 767px) {
    .hero-description {
      font-size: 0.7rem;
      line-height: 1.6;
    }
    
    .hero-cta-button {
      font-size: 1.04rem;
      padding: 0.96rem 1.92rem;
      gap: 0.8rem;
    }
    
    .hero-cta-button__arrow {
      width: 1.44rem;
      height: 1.44rem;
    }
  }
  
  /* Scroll Down Hint - 動態提示 */
  .hero-scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  
  .hero-scroll-hint__icon {
    width: 50px;
    height: 50px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    transition: all 0.3s ease;
    animation: bounce-hint 2s infinite;
  }
  
  .hero-scroll-hint__icon:hover {
    background-color: rgba(255, 255, 255, 1);
    transform: scale(1.1);
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.3);
  }
  
  .hero-scroll-hint__icon:active {
    transform: scale(0.95);
  }
  
  .hero-scroll-hint__arrow {
    width: 24px;
    height: 24px;
    color: #374151;
    /* 箭頭不動 */
    position: relative;
  }
  
  /* 只有外框動，箭頭不動 */
  @keyframes bounce-hint {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  
  /* 只有 icon 動，箭頭保持不動 */
  .hero-scroll-hint__icon {
    animation: bounce-hint 2s infinite;
  }
  
  @media screen and (max-width: 1023px) {
    .hero-section .grid > div:last-child {
      display: none;
    }
    
    .hero-scroll-hint {
      bottom: 1rem;
    }
    
    .hero-scroll-hint__icon {
      width: 40px;
      height: 40px;
    }
    
    .hero-scroll-hint__arrow {
      width: 20px;
      height: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": []
}
{% endschema %}