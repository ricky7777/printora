<!-- Hero Section -->
<section id="hero" class="relative bg-mint min-h-screen flex items-center overflow-hidden hero-section">
  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-8 py-32 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left Content -->
      <div class="space-y-8">
        <!-- Small Title -->
        <div class="text-deep-gray font-light text-sm tracking-[0.3em] uppercase">
          
        </div>
        
        <!-- Main Title -->
        <h1 class="text-6xl lg:text-7xl font-black text-deep-gray leading-tight">
          Your Design<br>
          <span class="text-deep-gray">— Your Rules</span>
        </h1>
        
        <!-- Decorative Lines -->
        <div class="flex items-center space-x-3 py-4">
          <div class="w-8 h-1 bg-mint-dark rounded-full"></div>
          <div class="w-8 h-1 bg-white rounded-full"></div>
          <div class="w-8 h-1 bg-pastel-pink rounded-full"></div>
        </div>
        
        <!-- Description -->
        <p class="text-soft-gray font-light text-lg leading-relaxed max-w-lg">
          Professional printing technology that perfectly brings your creative designs to life. 
          From concept to finished product, we're here to make every idea a reality.
        </p>
        
        <!-- CTA Button -->
        <div class="pt-8">
          <a href="/collections/all" class="bg-pastel-pink text-white font-semibold px-8 py-4 rounded-3xl soft-shadow hover:shadow-lg transition-all duration-300 inline-flex items-center space-x-3 group">
            <span>Upload Your Design</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Right Side - Image -->
      <div class="hidden lg:flex items-center justify-center">
        <div class="relative w-full max-w-lg">
          <img
            src="{{ 'hero-dtf.jpg' | asset_url }}"
            alt="DTF Printing Technology - Professional custom T-shirt printing"
            class="w-full h-auto rounded-2xl shadow-2xl object-cover"
            loading="eager"
            width="800"
            height="600"
          >
        </div>
      </div>
    </div>
  </div>
  
  <!-- Curved Bottom -->
  <div class="absolute bottom-0 left-0 w-full h-16 hero-curve hero-curve-bg"></div>
  
  <!-- Scroll Down Hint -->
  <a href="#pricing-cards" class="hero-scroll-hint" onclick="event.preventDefault(); const target = document.getElementById('pricing-cards'); const targetPosition = target.getBoundingClientRect().top + window.pageYOffset; const offset = targetPosition * 0.05; window.scrollTo({ top: targetPosition - offset, behavior: 'smooth' });">
    <div class="hero-scroll-hint__icon">
      <svg class="hero-scroll-hint__arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </a>
</section>

<style>
  /* Hero Section 背景色 - 已在 theme.liquid 中統一設定，使用 --color-header-hero-bg */
  .hero-section img {
    max-width: 100%;
    height: auto;
  }
  
  /* Hero 底部曲線區塊使用統一的背景色 */
  .hero-curve-bg {
    background-color: var(--color-header-hero-bg);
  }
  
  /* Scroll Down Hint - 動態提示 */
  .hero-scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  
  .hero-scroll-hint__icon {
    width: 50px;
    height: 50px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    transition: all 0.3s ease;
    animation: bounce-hint 2s infinite;
  }
  
  .hero-scroll-hint__icon:hover {
    background-color: rgba(255, 255, 255, 1);
    transform: scale(1.1);
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.3);
  }
  
  .hero-scroll-hint__icon:active {
    transform: scale(0.95);
  }
  
  .hero-scroll-hint__arrow {
    width: 24px;
    height: 24px;
    color: #374151;
    /* 箭頭不動 */
    position: relative;
  }
  
  /* 只有外框動，箭頭不動 */
  @keyframes bounce-hint {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  
  /* 只有 icon 動，箭頭保持不動 */
  .hero-scroll-hint__icon {
    animation: bounce-hint 2s infinite;
  }
  
  @media screen and (max-width: 1023px) {
    .hero-section .grid > div:last-child {
      display: none;
    }
    
    .hero-scroll-hint {
      bottom: 1rem;
    }
    
    .hero-scroll-hint__icon {
      width: 40px;
      height: 40px;
    }
    
    .hero-scroll-hint__arrow {
      width: 20px;
      height: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Hero"
}
{% endschema %}