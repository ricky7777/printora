{% comment %}
  PrintOra Homepage Hero Section
  Professional and friendly design for custom T-shirt store
{% endcomment %}

<section class="homepage-hero shopify-section color-{{ section.settings.color_scheme }}">
  <div class="homepage-hero__container">
    <div class="homepage-hero__content">
      <div class="homepage-hero__text">
        {%- if section.settings.subheading != blank -%}
          <div class="homepage-hero__subheading">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <div class="homepage-hero__heading-wrapper">
            <div>
              <h1 class="homepage-hero__heading">
                {{ section.settings.heading }}
              </h1>
              <div class="homepage-hero__heading-decoration">
                <div class="homepage-hero__heading-decoration-line homepage-hero__heading-decoration-line--mint-dark"></div>
                <div class="homepage-hero__heading-decoration-line homepage-hero__heading-decoration-line--white"></div>
                <div class="homepage-hero__heading-decoration-line homepage-hero__heading-decoration-line--pink"></div>
              </div>
            </div>
            {%- if section.settings.heading_icon != blank -%}
              <div class="homepage-hero__heading-icon">
                <img
                  src="{{ section.settings.heading_icon | image_url: width: 200 }}"
                  alt="T-Shirt Icon"
                  width="200"
                  height="200"
                  loading="eager"
                >
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="homepage-hero__description">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="homepage-hero__button button button--primary">
            {{ section.settings.button_label }}
            <svg class="homepage-hero__button-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M17 8l4 4m0 0l-4 4m4-4H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="homepage-hero__image">
          <img
            srcset="{%- if section.settings.image.width >= 375 -%}{{ section.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                    {%- if section.settings.image.width >= 750 -%}{{ section.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if section.settings.image.width >= 1100 -%}{{ section.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                    {%- if section.settings.image.width >= 1500 -%}{{ section.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                    {{ section.settings.image | image_url }} {{ section.settings.image.width }}w"
            src="{{ section.settings.image | image_url: width: 1500 }}"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            loading="eager"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        </div>
      {%- else -%}
        <div class="homepage-hero__visual-element">
          <div class="homepage-hero__visual-circle"></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .homepage-hero.shopify-section {
    display: flex !important;
    grid-template-columns: none !important;
    padding: 0;
    background: #A8E6CF;
    position: relative;
    overflow: hidden;
    align-items: center;
    min-height: 90vh;
    height: 90vh;
    width: 100%;
  }

  .homepage-hero.shopify-section::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 160px;
    background: #FFFFFF;
    clip-path: polygon(0 0, 100% 0, 85% 100%, 0% 100%);
    z-index: 1;
  }

  @media screen and (min-width: 990px) {
    .homepage-hero.shopify-section::after {
      height: 200px;
    }
  }

  @media screen and (min-width: 990px) {
    .homepage-hero.shopify-section {
      min-height: 100vh;
    }
  }


  .homepage-hero__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 8rem 2rem;
    position: relative;
    z-index: 10;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .homepage-hero__container {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding: 8rem 2rem;
    }
  }

  .homepage-hero__content {
    display: contents;
  }

  .homepage-hero__text {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: left;
    position: relative;
    z-index: 3;
  }
  
  @media screen and (min-width: 1024px) {
    .homepage-hero__text {
      gap: 2rem;
    }
  }

  .homepage-hero__heading-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .homepage-hero__heading {
    font-size: 6rem;
    font-weight: 900;
    line-height: 1.25;
    margin: 0;
    color: #374151;
    letter-spacing: -0.025em;
    font-family: var(--font-primary--family);
    position: relative;
    z-index: 4;
  }
  
  @media screen and (min-width: 1024px) {
    .homepage-hero__heading {
      font-size: 7.2rem;
    }
  }

  .homepage-hero__heading-decoration {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 0;
    position: relative;
    z-index: 4;
  }

  .homepage-hero__heading-decoration-line {
    height: 4px;
    border-radius: 9999px;
  }

  .homepage-hero__heading-decoration-line--mint-dark {
    width: 32px;
    background: #C8F0E0;
  }

  .homepage-hero__heading-decoration-line--white {
    width: 32px;
    background: #FFFFFF;
  }

  .homepage-hero__heading-decoration-line--pink {
    width: 32px;
    background: #FFB6C1;
  }


  .homepage-hero__heading-icon {
    flex-shrink: 0;
    width: clamp(120px, 15vw, 200px);
    height: clamp(120px, 15vw, 200px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .homepage-hero__heading-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .homepage-hero__heading-wrapper {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .homepage-hero__heading-icon {
      width: 100px;
      height: 100px;
    }
  }

  .homepage-hero__subheading {
    font-size: 1.4rem;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: #374151;
    margin: 0;
    font-family: var(--font-primary--family);
  }

  @media screen and (min-width: 990px) {
    .homepage-hero__heading {
      margin-bottom: 1.5rem;
    }
  }

  .homepage-hero__description {
    font-size: 1.8rem;
    line-height: 1.75;
    color: #374151;
    margin: 0;
    font-weight: 300;
    max-width: 32rem;
    position: relative;
    z-index: 4;
  }
  
  @media screen and (min-width: 1024px) {
    .homepage-hero__description {
      max-width: 100%;
    }
  }

  .homepage-hero__description p {
    color: #374151;
    margin: 0;
    font-size: inherit;
  }

  @media screen and (min-width: 990px) {
    .homepage-hero__description {
      margin-bottom: 2rem;
    }
  }

  .homepage-hero__description p {
    margin: 0;
  }

  .homepage-hero__button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.6rem 3.2rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 1.5rem;
    transition: all 0.3s ease;
    background: #FFB6C1;
    color: #FFFFFF;
    border: none;
    width: fit-content;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
    position: relative;
    z-index: 4;
  }

  .homepage-hero__button:hover {
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .homepage-hero__button-icon {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .homepage-hero__button:hover .homepage-hero__button-icon {
    transform: translateX(4px);
  }

  .homepage-hero__image {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    padding: 2rem;
  }

  .homepage-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transform: rotate(15deg) translateY(-10px);
    filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.2));
    transition: transform 0.5s ease;
  }

  .homepage-hero__image:hover img {
    transform: rotate(12deg) translateY(-15px) scale(1.03);
  }

  @media screen and (max-width: 989px) {
    .homepage-hero__image {
      order: -1;
      height: 40vh;
      min-height: 300px;
    }

    .homepage-hero__image img {
      transform: rotate(-5deg) translateY(0);
    }

    .homepage-hero__text {
      padding: 3rem 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Homepage Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Your Design — Your Rules",
      "label": "Heading"
    },
    {
      "type": "image_picker",
      "id": "heading_icon",
      "label": "Heading Icon",
      "info": "Upload T-shirt icon image to display next to the heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Professional printing technology that perfectly brings your creative designs to life<br>From concept to finished product, we're here to make every idea a reality</p>",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Upload Your Design",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Homepage Hero"
    }
  ]
}
{% endschema %}

