{% schema %}
{
  "name": "Header"
}
{% endschema %}
<header class="fixed top-0 w-full bg-mint z-50">
        <div class="max-w-7xl mx-auto px-8 py-6">
            <div class="flex items-center justify-between">
                <!-- Logo -->
                <div class="header__logo">
                    {%- assign logo_image_name = 'printora_logo.png' -%}
                    <img
                        src="{{ logo_image_name | asset_url }}"
                        alt="PrintOra"
                        class="header__logo-image"
                        loading="eager"
                    >
                </div>
                
                <!-- Navigation -->
                <nav class="hidden md:flex items-center space-x-12">
                    <a href="#" class="text-white font-light hover:opacity-80 transition-opacity">Home</a>
                    <a href="#" class="text-white font-light hover:opacity-80 transition-opacity">Catalog</a>
                    <a href="#" class="text-white font-light hover:opacity-80 transition-opacity">Contact</a>
                </nav>
                
                <!-- Cart Icon -->
                <div class="flex items-center">
                    <svg class="w-6 h-6 text-deep-gray stroke-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.5 6M7 13l-1.5-6m0 0h14M7 13v6a2 2 0 002 2h6a2 2 0 002-2v-6" />
                    </svg>
                </div>
            </div>
        </div>
    </header>

<style>
  .header__logo {
    display: flex;
    align-items: center;
  }
  
  .header__logo-image {
    max-height: 2.4rem;
    max-width: 9rem;
    height: auto;
    width: auto;
    object-fit: contain;
  }
  
  @media screen and (max-width: 767px) {
    .header__logo-image {
      max-height: 1.8rem;
      max-width: 7.2rem;
    }
  }
</style>