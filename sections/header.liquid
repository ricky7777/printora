<header class="header" role="banner">
  <div class="header__container">
    <div class="header__inner">
      <div class="header__logo">
        <a href="{{ routes.root_url }}" class="header__logo-link">
          {%- if section.settings.logo_image != blank -%}
            <img
              src="{{ section.settings.logo_image | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              class="header__logo-image"
              width="300"
              height="120"
              loading="eager"
            >
          {%- elsif settings.logo != blank -%}
            <img
              src="{{ settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              class="header__logo-image"
              width="300"
              height="120"
              loading="eager"
            >
          {%- elsif section.settings.logo_icon != blank -%}
            <img
              src="{{ section.settings.logo_icon | image_url: width: 300 }}"
              alt="PrintOra"
              class="header__logo-image"
              width="300"
              height="120"
              loading="eager"
            >
          {%- else -%}
            <div class="header__logo-text">
              <span class="header__logo-text--print">Print</span><span class="header__logo-text--ora">Ora</span>
            </div>
          {%- endif -%}
        </a>
      </div>

      <nav class="header__nav" role="navigation">
        <ul class="header__menu">
          {%- for link in linklists.main-menu.links -%}
            <li class="header__menu-item">
              <a href="{{ link.url }}" class="header__menu-link">
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="header__actions">
        <a href="{{ routes.cart_url }}" class="header__cart-link">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-cart" viewBox="0 0 18 19">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M6.5 15.5C5.67 15.5 5 16.17 5 17s.67 1.5 1.5 1.5S8 17.83 8 17s-.67-1.5-1.5-1.5zM15.5 15.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5S17 17.83 17 17s-.67-1.5-1.5-1.5zM0 1h2.5l1.5 7h11l1.5-7H0zm2.5 8L4 3h11l1.5 6H2.5z"/>
          </svg>
          <span class="visually-hidden">Cart</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    background: #5EC4B0;
    backdrop-filter: none;
    border-bottom: none;
    padding: 1.5rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: none;
  }

  @media screen and (min-width: 990px) {
    .header {
      padding: 1.25rem 0;
    }
  }

  .header__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header__logo-link {
    display: flex;
    align-items: center;
    gap: 0;
    text-decoration: none;
  }

  .header__logo-image {
    height: auto;
    max-height: 80px;
    width: auto;
    max-width: 250px;
    object-fit: contain;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .header__logo-image {
      max-height: 60px;
      max-width: 200px;
    }
  }

  .header__logo-text {
    font-size: 3rem;
    font-weight: 700;
    font-family: var(--font-primary--family);
    line-height: 1;
    display: flex;
    align-items: baseline;
  }

  @media screen and (max-width: 749px) {
    .header__logo-text {
      font-size: 2.25rem;
    }
  }

  .header__logo-text--print {
    color: #FFFFFF;
    -webkit-text-stroke: 2.5px #111827;
    text-stroke: 2.5px #111827;
    paint-order: stroke fill;
    letter-spacing: -0.02em;
    position: relative;
  }

  .header__logo-text--ora {
    color: #FFFFFF;
    -webkit-text-stroke: 2.5px #111827;
    text-stroke: 2.5px #111827;
    paint-order: stroke fill;
    letter-spacing: -0.02em;
    position: relative;
  }

  /* Fallback for browsers that don't support text-stroke */
  @supports not (-webkit-text-stroke: 2px #4A4A6A) {
    .header__logo-text--print {
      text-shadow: 
        -2px -2px 0 #4A4A6A,
        2px -2px 0 #4A4A6A,
        -2px 2px 0 #4A4A6A,
        2px 2px 0 #4A4A6A,
        -2px 0 0 #4A4A6A,
        2px 0 0 #4A4A6A,
        0 -2px 0 #4A4A6A,
        0 2px 0 #4A4A6A,
        -1px -1px 0 #4A4A6A,
        1px -1px 0 #4A4A6A,
        -1px 1px 0 #4A4A6A,
        1px 1px 0 #4A4A6A;
    }

    .header__logo-text--ora {
      text-shadow: 
        -2px -2px 0 #4A4A6A,
        2px -2px 0 #4A4A6A,
        -2px 2px 0 #4A4A6A,
        2px 2px 0 #4A4A6A,
        -2px 0 0 #4A4A6A,
        2px 0 0 #4A4A6A,
        0 -2px 0 #4A4A6A,
        0 2px 0 #4A4A6A,
        -1px -1px 0 #4A4A6A,
        1px -1px 0 #4A4A6A,
        -1px 1px 0 #4A4A6A,
        1px 1px 0 #4A4A6A;
    }
  }

  @media screen and (max-width: 749px) {
    .header__logo-text {
      font-size: 1.5rem;
    }

    .header__logo-icon {
      width: 50px;
      height: 50px;
    }
  }

  .header__nav {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .header__nav {
      display: block;
    }
  }

  .header__menu {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2rem;
  }

  .header__menu-link {
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 500;
    font-size: 1.25rem;
    transition: opacity 0.3s ease;
  }

  .header__menu-link:hover {
    opacity: 0.8;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__cart-link {
    color: #FFFFFF;
    display: flex;
    align-items: center;
    transition: opacity 0.3s ease;
  }

  .header__cart-link:hover {
    opacity: 0.8;
  }

  .header__cart-link svg {
    width: 28px;
    height: 28px;
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_icon",
      "label": "Logo Icon",
      "info": "Upload T-shirt icon image"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image",
      "info": "Upload PrintOra logo image (will replace text logo)"
    }
  ]
}
{% endschema %}

