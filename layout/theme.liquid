<!doctype html>
<html lang="en">
  <head>
<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PrintOra - Your Design, Your Rules</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'mint': '#A8E6CF',
                        'mint-light': '#C8F0E0',
                        'mint-dark': '#88D4AB',
                        'pastel-pink': '#FFB6C1',
                        'soft-gray': '#6B7280',
                        'deep-gray': '#374151'
                    },
                    fontFamily: {
                        'sans': ['Inter', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Header 和 Hero 區塊共用背景色 - 在這裡統一修改 */
            --color-header-hero-bg: #86CFB4;
        }
        
        .hero-curve {
            clip-path: polygon(0 0, 100% 0, 85% 100%, 0% 100%);
        }
        .soft-shadow {
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
        }
        .card-shadow {
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
        }
        
        /* Header 背景色 */
        header {
            background-color: var(--color-header-hero-bg) !important;
        }
        
        /* Hero Section 背景色 */
        .hero-section {
            background-color: var(--color-header-hero-bg) !important;
        }
    </style>
    <link rel="stylesheet" href="{{ 'original-inline.css' | asset_url }}">
    {% comment %} Shopify content_for_header will be injected here {% endcomment %}
    {% if content_for_header %}{{ content_for_header }}{% endif %}
  </head>
  <body class="template-{{ template | replace: '.', '-' }}">
    {% section 'header' %}
    <main role="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    {% if content_for_footer %}{{ content_for_footer }}{% endif %}
  </body>
</html>
