<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="{{ 'favicon.ico' | asset_url }}">
    <title>{% if template.name == 'product' %}{{ product.title | escape }} | {% elsif template.name == 'page' and page.title != blank %}{{ page.title | escape }} | {% endif %}{{ shop.name | escape }}{% if template.name == 'index' %} - Custom T-Shirt Printing New Zealand{% endif %}</title>
    <meta name="description" content="{% if template.name == 'product' %}{{ product.description | strip_html | truncate: 160 | escape }}{% elsif template.name == 'page' and page.content != blank %}{{ page.content | strip_html | truncate: 160 | escape }}{% else %}PrintOra offers custom T-shirt printing in New Zealand. Design your own tee with our online editor. DTF printing, fast delivery, premium quality. From $28 NZD.{% endif %}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- comment -%} Use noindex for cart, search, 404 so GSC can index important pages only. For "Blocked by robots.txt" in GSC, check Shopify Admin > Online Store > Preferences (robots.txt is platform-generated). {%- endcomment -%}
    {%- if template.name == 'cart' or template.name == 'search' or template.name == '404' or template.name == 'password' -%}
    <meta name="robots" content="noindex, nofollow">
    {%- else -%}
    <meta name="robots" content="index, follow">
    {%- endif -%}
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:title" content="{% if template.name == 'product' %}{{ product.title | escape }}{% elsif template.name == 'page' and page.title != blank %}{{ page.title | escape }}{% else %}PrintOra - Custom T-Shirt Printing New Zealand{% endif %}">
    <meta property="og:description" content="{% if template.name == 'product' %}{{ product.description | strip_html | truncate: 200 | escape }}{% else %}Design your own custom T-shirts in New Zealand. Premium DTF printing, fast delivery. Upload your design and order online.{% endif %}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' | default: 'en_NZ' }}">
    {% if template.name == 'product' and product.featured_image %}<meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">{% elsif template.name == 'index' %}<meta property="og:image" content="https:{{ 'hero-dtf.jpg' | asset_url }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if template.name == 'product' %}{{ product.title | escape }}{% else %}PrintOra - Custom T-Shirt Printing NZ{% endif %}">
    <meta name="twitter:description" content="{% if template.name == 'product' %}{{ product.description | strip_html | truncate: 200 | escape }}{% else %}Design custom T-shirts in New Zealand. Premium DTF printing from $28.{% endif %}">
    <link rel="stylesheet" href="{{ 'tailwind.css' | asset_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Header 和 Hero 區塊共用背景色 - 在這裡統一修改 */
            --color-header-hero-bg: #86CFB4;
        }
        
        .hero-curve {
            clip-path: polygon(0 0, 100% 0, 85% 100%, 0% 100%);
        }
        .soft-shadow {
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
        }
        .card-shadow {
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
        }
        
        /* Header 背景色 */
        header {
            background-color: var(--color-header-hero-bg) !important;
        }
        
        /* Hero Section 背景色 */
        .hero-section {
            background-color: var(--color-header-hero-bg) !important;
        }
    </style>
    {% if template.name == 'index' %}<link rel="preload" href="{{ 'hero-dtf.jpg' | asset_url }}" as="image">{% endif %}
    <link rel="stylesheet" href="{{ 'original-inline.css' | asset_url }}">
    
    <script>
      // Prevent CORS and CSP errors at the source in local development
      (function() {
        const isLocalDev = window.location.hostname === 'localhost' || 
                          window.location.hostname === '127.0.0.1';
        
        if (isLocalDev) {
          // Prevent analytics requests before they are sent
          const originalFetch = window.fetch;
          window.fetch = function(...args) {
            const url = args[0];
            if (typeof url === 'string' && url.includes('/api/collect')) {
              // Return a successful but empty response to prevent CORS errors
              return Promise.resolve(new Response(null, { status: 200, statusText: 'OK' }));
            }
            return originalFetch.apply(this, args);
          };
          
          // Prevent XMLHttpRequest to /api/collect
          const originalXHROpen = XMLHttpRequest.prototype.open;
          XMLHttpRequest.prototype.open = function(method, url, ...rest) {
            if (typeof url === 'string' && url.includes('/api/collect')) {
              // Prevent the request
              this._prevented = true;
              return;
            }
            return originalXHROpen.apply(this, [method, url, ...rest]);
          };
          
          const originalXHRSend = XMLHttpRequest.prototype.send;
          XMLHttpRequest.prototype.send = function(...args) {
            if (this._prevented) {
              // Silently prevent the request
              return;
            }
            return originalXHRSend.apply(this, args);
          };
          
          // Prevent sendBeacon to /api/collect
          const originalSendBeacon = navigator.sendBeacon;
          if (originalSendBeacon) {
            navigator.sendBeacon = function(url, ...rest) {
              if (typeof url === 'string' && url.includes('/api/collect')) {
                // Return true to indicate "success" but don't actually send
                return true;
              }
              return originalSendBeacon.apply(navigator, [url, ...rest]);
            };
          }
          
          // Prevent iframe creation for shop.app
          const originalCreateElement = document.createElement;
          document.createElement = function(tagName, ...rest) {
            const element = originalCreateElement.apply(document, [tagName, ...rest]);
            
            if (tagName.toLowerCase() === 'iframe') {
              // Intercept src attribute setting
              const originalSetAttribute = element.setAttribute;
              element.setAttribute = function(name, value) {
                if (name === 'src' && typeof value === 'string' && value.includes('shop.app')) {
                  // Prevent setting src to shop.app
                  return;
                }
                return originalSetAttribute.apply(this, [name, value]);
              };
              
              // Also intercept direct property assignment
              Object.defineProperty(element, 'src', {
                set: function(value) {
                  if (typeof value === 'string' && value.includes('shop.app')) {
                    // Prevent setting src to shop.app
                    return;
                  }
                  Object.defineProperty(this, 'src', {
                    value: value,
                    writable: true,
                    configurable: true
                  });
                },
                get: function() {
                  return this.getAttribute('src') || '';
                },
                configurable: true
              });
            }
            
            return element;
          };
        }
      })();
    </script>
    
    {% comment %} AEO: Product Schema JSON-LD for AI search engines (Gemini, ChatGPT) {% endcomment %}
    {% if template.name == 'product' and product %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 200 | json }},
      "image": {{ product.featured_image | image_url: width: 600 | json }},
      "brand": {
        "@type": "Brand",
        "name": "PrintOra"
      },
      "offers": {
        "@type": "Offer",
        "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
        "priceCurrency": "NZD",
        "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
        "url": {{ request.origin | append: product.url | json }},
        "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}"
      }
    }
    </script>
    {% endif %}

    {% comment %} AEO: BreadcrumbList for product pages {% endcomment %}
    {% if template.name == 'product' and product %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" },
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      ]
    }
    </script>
    {% endif %}

    {% comment %} AEO: Organization + WebSite + LocalBusiness JSON-LD (site-wide for AI search) {% endcomment %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "{{ shop.url }}/#organization",
          "name": "PrintOra",
          "url": "{{ shop.url }}",
          "logo": {
            "@type": "ImageObject",
            "url": "https:{{ 'printora_logo.png' | asset_url }}"
          }
        },
        {
          "@type": "WebSite",
          "@id": "{{ shop.url }}/#website",
          "name": "{{ shop.name }}",
          "url": "{{ shop.url }}",
          "publisher": { "@id": "{{ shop.url }}/#organization" },
          "description": "Custom T-shirt printing in New Zealand. Design your own tee with our online editor. DTF printing, fast delivery, premium quality."
        },
        {
          "@type": "LocalBusiness",
          "@id": "{{ shop.url }}/#localbusiness",
          "name": "PrintOra",
          "url": "{{ shop.url }}",
          "description": "Custom T-shirt printing and design services in New Zealand. Upload your design, choose your size, and get premium DTF-printed tees delivered.",
          "priceRange": "$28 - $45 NZD",
          "areaServed": {
            "@type": "Country",
            "name": "New Zealand"
          },
          "currenciesAccepted": "NZD"
        }
      ]
    }
    </script>

    {% comment %} AEO: ItemList of pricing options for homepage (helps AI cite PrintOra offerings) {% endcomment %}
    {% if template.name == 'index' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "PrintOra Custom T-Shirt Options",
      "description": "Custom T-shirt printing options in New Zealand",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Small Logo - $28 NZD", "description": "Perfect for chest logos and small designs" },
        { "@type": "ListItem", "position": 2, "name": "Standard Print - $35 NZD", "description": "Ideal for most designs and graphics" },
        { "@type": "ListItem", "position": 3, "name": "Large Print - $45 NZD", "description": "Maximum impact for bold designs" }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Where can I get custom T-shirts printed in New Zealand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PrintOra offers custom T-shirt printing across New Zealand. Upload your design online, choose from Small Logo ($28), Standard Print ($35), or Large Print ($45), and we deliver in 7-10 working days."
          }
        },
        {
          "@type": "Question",
          "name": "How does PrintOra custom T-shirt printing work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use our online design editor to upload your artwork, position it on the tee, and choose size and color. We use DTF (Direct to Film) printing for vibrant, long-lasting designs. Prices start from $28 NZD including GST."
          }
        },
        {
          "@type": "Question",
          "name": "What is DTF printing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "DTF (Direct to Film) printing transfers your design onto a special film, then onto the fabric. It produces vibrant colors and durable prints that won't fade or crack, ideal for custom T-shirts."
          }
        }
      ]
    }
    </script>
    {% endif %}

    {% comment %} Shopify content_for_header will be injected here {% endcomment %}
    {% if content_for_header %}{{ content_for_header }}{% endif %}
  </head>
  <body class="template-{{ template | replace: '.', '-' }}">
    {% section 'header' %}
    <main role="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    {% if content_for_footer %}{{ content_for_footer }}{% endif %}
  </body>
</html>
