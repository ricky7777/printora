{% comment %}
  Print Editor Page - Alternative name for the same editor
  Standalone sub-page that does not affect the main theme
{% endcomment %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.title }} - {{ shop.name }}</title>
  <link rel="stylesheet" href="{{ 'editor.css' | asset_url }}">
</head>
<body class="editor-page-body">
  <div class="editor-page">
    <div class="editor-container">
      <!-- Left Side: Preview Area -->
      <div class="editor-preview-section">
        <div class="preview-wrapper">
          <canvas id="tshirtCanvas"></canvas>
          
          <!-- Upload Overlay -->
          <div id="uploadOverlay" class="upload-overlay">
            <label for="imageUpload" class="upload-button">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 15V3M12 3L8 7M12 3L16 7M3 15V19C3 19.5304 3.21071 20.0391 3.58579 20.4142C3.96086 20.7893 4.46957 21 5 21H19C19.5304 21 20.0391 20.7893 20.4142 20.4142C20.7893 20.0391 21 19.5304 21 19V15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Upload Your Design</span>
            </label>
            <input type="file" id="imageUpload" accept="image/*" style="display: none;">
          </div>
          
          <!-- Instructions -->
          <div id="instructions" class="instructions" style="display: none;">
            Drag to move, pinch to scale/rotate
          </div>
        </div>
      </div>

      <!-- Right Side: Controls -->
      <div class="editor-controls-section">
        <!-- Price Display -->
        <div class="price-display">
          <div class="price-amount" id="priceDisplay">$45.00</div>
          <div class="price-note">Tax included.</div>
        </div>

        <!-- Print Size Selection -->
        <div class="control-group">
          <h3 class="control-title">Print Size</h3>
          <div class="print-size-buttons">
            <button class="print-size-btn" data-size="small">Small</button>
            <button class="print-size-btn active" data-size="standard">Standard</button>
            <button class="print-size-btn" data-size="large">Large</button>
          </div>
        </div>

        <!-- Size Selection -->
        <div class="control-group">
          <div class="size-header">
            <h3 class="control-title">Size: <span id="selectedSize">M</span></h3>
            <button class="size-chart-btn" id="sizeChartBtn">View Size Chart</button>
          </div>
          <div class="size-buttons">
            <button class="size-btn active" data-size="S">S</button>
            <button class="size-btn active" data-size="M">M</button>
            <button class="size-btn" data-size="L">L</button>
            <button class="size-btn" data-size="XL">XL</button>
            <button class="size-btn" data-size="2XL">2XL</button>
            <button class="size-btn" data-size="3XL">3XL</button>
            <button class="size-btn" data-size="5XL">5XL</button>
          </div>
        </div>

        <!-- Color Selection -->
        <div class="control-group">
          <h3 class="control-title">Color: <span id="selectedColor">Black</span></h3>
          <div class="color-buttons">
            <button class="color-btn active" data-color="black">
              <span class="color-swatch black"></span>
            </button>
            <button class="color-btn" data-color="white">
              <span class="color-swatch white"></span>
            </button>
          </div>
        </div>

        <!-- Quantity Selection -->
        <div class="control-group">
          <h3 class="control-title">Quantity</h3>
          <div class="quantity-selector">
            <button class="quantity-btn" id="decrementBtn">-</button>
            <input type="number" id="quantityInput" value="1" min="1" max="300" readonly>
            <button class="quantity-btn" id="incrementBtn">+</button>
          </div>
        </div>

        <!-- Reset Rotation Button -->
        <div class="control-group" id="resetRotationGroup" style="display: none;">
          <button class="reset-rotation-btn" id="resetRotationBtn">Reset Rotation</button>
        </div>

        <!-- Checkout Button -->
        <button class="checkout-btn" id="checkoutBtn">Checkout</button>
      </div>
    </div>
  </div>

  <!-- Size Chart Modal -->
  <div id="sizeChartModal" class="modal">
    <div class="modal-content">
      <span class="modal-close">&times;</span>
      <img src="{{ 'size_chart.png' | asset_url }}" alt="Size Chart" class="size-chart-image">
    </div>
  </div>

  <script>
    // Set asset base URL for JavaScript
    window.assetBaseUrl = '{{ "tee_black.png" | asset_url }}'.replace('tee_black.png', '');
  </script>
  <script src="{{ 'editor.js' | asset_url }}" defer></script>
</body>
</html>
