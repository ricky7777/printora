{% layout none %}

{%- comment -%}
  Order Summary Page
  Converted from assets/order-summary.html
  IMPORTANT: Shopify assets directory is FLAT - no subdirectories allowed!
  All resources are in assets root
{%- endcomment -%}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Summary - PrintOra</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'mint': '#A8E6CF',
            'mint-light': '#C8F0E0',
            'mint-dark': '#88D4AB',
            'pastel-pink': '#FFB6C1',
            'soft-gray': '#6B7280',
            'deep-gray': '#374151'
          },
          fontFamily: {
            'sans': ['Inter', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ 'original-inline.css' | asset_url }}">
  <style>
    :root {
      --color-header-hero-bg: #86CFB4;
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background-color: #E8F5E9;
      color: #333;
      line-height: 1.6;
      padding-top: 80px; /* Space for fixed header */
      margin: 0;
      min-height: 100vh;
    }
    
    html {
      margin: 0;
      padding: 0;
      width: 100%;
    }

    /* Header Styles */
    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      background-color: var(--color-header-hero-bg);
      z-index: 50;
      padding: 1.5rem 2rem;
    }

    .header-content {
      max-width: 1280px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header__logo-image {
      max-height: 2.4rem;
      max-width: 9rem;
      height: auto;
      width: auto;
      object-fit: contain;
    }

    /* Footer Styles */
    .footer {
      background-color: #4A4A6A;
      color: #FFFFFF;
      padding: 2rem 0 1.5rem;
      margin-top: 4rem;
      text-align: center;
    }

    .footer__copyright {
      margin: 0;
      opacity: 0.7;
      font-size: 1.4rem;
    }

    /* Order Summary Styles */
    main {
      width: 100%;
      background-color: #E8F5E9;
      min-height: calc(100vh - 80px);
    }
    
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 20px 20px 20px; /* Remove top padding */
      position: relative;
    }

    .header-section {
      background-color: transparent;
      padding: 20px;
      margin: 0;
      margin-top: 0;
      border-radius: 0;
      /* Use viewport width to extend full width */
      margin-left: calc(-50vw + 50%);
      margin-right: calc(-50vw + 50%);
      width: 100vw;
      padding-left: calc(50vw - 50% + 20px);
      padding-right: calc(50vw - 50% + 20px);
      box-sizing: border-box;
    }
    
    .container {
      padding-top: 0; /* Remove top padding to eliminate gap */
    }

    .header-section h1 {
      color: #333;
      font-size: 28px;
      font-weight: bold;
    }

    .content {
      display: flex;
      gap: 48px;
      align-items: flex-start;
    }

    @media (max-width: 968px) {
      .content {
        flex-direction: column;
        gap: 24px;
      }
    }

    .preview-section {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .preview-title {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 24px;
      color: #333;
      text-align: center;
    }

    .preview-container {
      width: 100%;
      max-width: 600px; /* 500px * 1.2 = 600px */
      height: auto;
      position: relative;
      background-color: #e0e0e0;
      border: 2px solid #B8E6D3;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #previewCanvas {
      width: 100%;
      height: auto;
      display: block;
      max-height: 600px; /* 500px * 1.2 = 600px */
    }

    .order-details-section {
      flex: 1;
      padding-top: 24px;
    }

    .detail-row {
      display: flex;
      margin-bottom: 12px;
      align-items: flex-start;
    }

    .detail-label {
      width: 120px;
      color: #666;
      font-size: 16px;
    }

    .detail-value {
      flex: 1;
      font-weight: bold;
      color: #333;
      font-size: 16px;
    }

    .total-price-container {
      margin-top: 24px;
      padding: 16px;
      background-color: rgba(184, 230, 211, 0.3);
      border-radius: 12px;
    }

    .total-price-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .total-price-row > div {
      display: flex;
      flex-direction: column;
    }

    .total-price-label {
      font-size: 20px;
      font-weight: bold;
      color: #333;
    }
    
    .total-price-label-note {
      font-size: 14px;
      font-weight: normal;
      color: #666;
      margin-top: 4px;
    }

    .total-price-value {
      font-size: 24px;
      font-weight: bold;
      color: #333;
    }

    .continue-button {
      width: 100%;
      margin-top: 32px;
      padding: 16px;
      background-color: #FF6B9D;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      transition: background-color 0.3s;
    }

    .continue-button:hover {
      background-color: #E55A8A;
    }

    .continue-button:active {
      transform: scale(0.98);
    }

    .contact-form-container {
      margin-top: 24px;
      padding: 20px;
      background-color: #f9f9f9;
      border-radius: 12px;
    }

    .contact-form-group {
      margin-bottom: 20px;
    }

    .contact-form-label {
      display: block;
      margin-bottom: 8px;
      font-size: 16px;
      font-weight: 600;
      color: #333;
    }

    .contact-form-label .required {
      color: #EF4444;
      margin-left: 4px;
    }

    .contact-form-input {
      width: 100%;
      padding: 12px;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      font-size: 16px;
      transition: border-color 0.3s;
      box-sizing: border-box;
    }

    .contact-form-input:focus {
      outline: none;
      border-color: #FF6B9D;
    }

    .contact-form-input.error {
      border-color: #EF4444;
    }

    .contact-form-textarea {
      width: 100%;
      padding: 12px;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      font-size: 16px;
      font-family: inherit;
      resize: vertical;
      min-height: 100px;
      transition: border-color 0.3s;
      box-sizing: border-box;
    }

    .contact-form-textarea:focus {
      outline: none;
      border-color: #FF6B9D;
    }

    .error-message {
      color: #EF4444;
      font-size: 14px;
      margin-top: 4px;
      display: none;
    }

    .error-message.show {
      display: block;
    }

    .phone-input-wrapper {
      display: flex;
      align-items: stretch;
    }

    .phone-prefix {
      display: flex;
      align-items: center;
      padding: 12px 16px;
      background-color: #f0f0f0;
      border: 2px solid #e0e0e0;
      border-right: none;
      border-radius: 8px 0 0 8px;
      font-size: 16px;
      color: #666;
      user-select: none;
      white-space: nowrap;
    }

    .phone-prefix .flag-icon {
      width: 20px;
      height: 15px;
      margin-right: 8px;
      object-fit: cover;
      border-radius: 2px;
    }

    .phone-input-wrapper .contact-form-input {
      border-radius: 0 8px 8px 0;
      flex: 1;
    }

    .phone-input-wrapper .contact-form-input.error {
      border-left: 2px solid #EF4444;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header>
    <div class="header-content">
      <div class="header__logo">
        <img
          src="{{ 'printora_logo.png' | asset_url }}"
          alt="PrintOra"
          class="header__logo-image"
          loading="eager"
        >
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <div class="container">
        <div class="header-section">

          </div>    
      <div class="content">
        <!-- Left side - Preview area -->
        <div class="preview-section">
          <div class="preview-container">
            <canvas id="previewCanvas"></canvas>
          </div>
        </div>

        <!-- Right side - Order details -->
        <div class="order-details-section">
          <div class="detail-row">
            <span class="detail-label">Size:</span>
            <span class="detail-value" id="sizeDisplay">-</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Quantity:</span>
            <span class="detail-value" id="quantityDisplay">-</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">T-Shirt Color:</span>
            <span class="detail-value" id="tshirtColorDisplay">-</span>
          </div>
          <div class="detail-row" id="printSizeRow" style="display: none;">
            <span class="detail-label">Print Size:</span>
            <span class="detail-value" id="printSizeDisplay">-</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Type:</span>
            <span class="detail-value" id="typeDisplay">-</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Items Subtotal:</span>
            <span class="detail-value" id="subtotalDisplay">-</span>
          </div>
          <div class="total-price-container">
            <div class="total-price-row">
              <div>
                <div class="total-price-label">Total Price</div>
                <div class="total-price-label-note">(include GST)</div>
              </div>
              <span class="total-price-value" id="totalPriceDisplay">-</span>
            </div>
          </div>

          <!-- Contact Information Form -->
          <div class="contact-form-container">
            <div class="contact-form-group">
              <label for="customerNickName" class="contact-form-label">
                Nick Name <span class="required">*</span>
              </label>
              <input 
                type="text" 
                id="customerNickName" 
                name="nickName" 
                class="contact-form-input" 
                placeholder="Enter your nick name"
                required
              >
              <div class="error-message" id="nickNameError">Please enter your nick name</div>
            </div>

            <div class="contact-form-group">
              <label for="customerEmail" class="contact-form-label">
                Email <span class="required">*</span>
              </label>
              <input 
                type="email" 
                id="customerEmail" 
                name="email" 
                class="contact-form-input" 
                placeholder="your.email@example.com"
                required
              >
              <div class="error-message" id="emailError">Please enter a valid email address</div>
            </div>

            <div class="contact-form-group">
              <label for="customerPhone" class="contact-form-label">
                Phone Number <span class="required">*</span>
              </label>
              <div class="phone-input-wrapper">
                <div class="phone-prefix">
                  <img src="https://flagcdn.com/w20/nz.png" alt="NZ" class="flag-icon" onerror="this.style.display='none'">
                  <span>+64</span>
                </div>
                <input 
                  type="tel" 
                  id="customerPhone" 
                  name="phone" 
                  class="contact-form-input" 
                  placeholder="21 123 4567"
                  required
                >
              </div>
              <div class="error-message" id="phoneError">Please enter your phone number</div>
            </div>

            <div class="contact-form-group">
              <label for="customerAddress" class="contact-form-label">
                Address <span class="required">*</span>
              </label>
              <input 
                type="text" 
                id="customerAddress" 
                name="address" 
                class="contact-form-input" 
                placeholder="Enter your address"
                required
              >
              <div class="error-message" id="addressError">Please enter your address</div>
            </div>

            <div class="contact-form-group">
              <label for="customerNotes" class="contact-form-label">
                Notes
              </label>
              <textarea 
                id="customerNotes" 
                name="notes" 
                class="contact-form-textarea" 
                placeholder="Any special instructions or notes..."
                rows="4"
              ></textarea>
            </div>
          </div>

          <button class="continue-button" id="continueButton">Continue to Payment</button>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="page-width">
      <div class="footer__bottom">
        <p class="footer__copyright">
          &copy; <span id="currentYear"></span> PrintOra. All rights reserved.
        </p>
      </div>
    </div>
  </footer>

  <script>
    // Set current year
    document.getElementById('currentYear').textContent = new Date().getFullYear();

    // Get order data from sessionStorage (stored via POST-like behavior)
    let orderData = null;
    try {
      const orderDataStr = sessionStorage.getItem('order_data');
      if (orderDataStr) {
        orderData = JSON.parse(orderDataStr);
        console.log('Order Summary: Retrieved order data from sessionStorage:', orderData);
        // Clear the data after reading (one-time use)
        sessionStorage.removeItem('order_data');
      }
    } catch (e) {
      console.error('Order Summary: Error reading order data from sessionStorage:', e);
    }
    
    // Fallback to URL parameters if sessionStorage data is not available
    const urlParams = new URLSearchParams(window.location.search);
    const designId = urlParams.get('designId');
    
    // Get screenshot from sessionStorage
    let previewImage = null;
    try {
      previewImage = sessionStorage.getItem('checkout_preview_image');
      console.log('Order Summary: Retrieved preview image from sessionStorage:', previewImage ? 'found (' + previewImage.length + ' chars)' : 'not found');
    } catch (e) {
      console.error('Order Summary: Error reading sessionStorage:', e);
    }
    
    // Get order parameters from sessionStorage (POST data) or URL (fallback)
    const size = orderData?.size || urlParams.get('size');
    const quantity = parseInt(orderData?.quantity || urlParams.get('quantity') || '1');
    const price = parseFloat(orderData?.price || urlParams.get('price') || '0');
    const type = orderData?.type || urlParams.get('type');
    const printSize = orderData?.printSize || urlParams.get('printSize');
    const tshirtColor = orderData?.tshirtColor || urlParams.get('tshirtColor');
    const imageX = parseFloat(orderData?.imageX || urlParams.get('imageX') || '0');
    const imageY = parseFloat(orderData?.imageY || urlParams.get('imageY') || '0');
    const imageScale = parseFloat(orderData?.imageScale || urlParams.get('imageScale') || '1');
    const imageRotation = parseFloat(orderData?.imageRotation || urlParams.get('imageRotation') || '0');
    
    console.log('Order Summary: Order data - size:', size, 'quantity:', quantity, 'price:', price, 'type:', type, 'printSize:', printSize, 'tshirtColor:', tshirtColor);

    // Display order details
    document.getElementById('sizeDisplay').textContent = size || '-';
    document.getElementById('quantityDisplay').textContent = quantity.toString();
    document.getElementById('tshirtColorDisplay').textContent = tshirtColor === 'black' ? 'Black' : 'White';
    
    if (printSize) {
      document.getElementById('printSizeRow').style.display = 'flex';
      document.getElementById('printSizeDisplay').textContent = printSize.charAt(0).toUpperCase() + printSize.slice(1);
    }
    
    document.getElementById('typeDisplay').textContent = type || '-';
    
    // Calculate and display subtotal (quantity * price)
    const subtotal = price * quantity;
    document.getElementById('subtotalDisplay').textContent = '$' + subtotal.toFixed(2);
    
    // Calculate total price (product price * quantity, no shipping fee)
    const totalPrice = price * quantity;
    document.getElementById('totalPriceDisplay').textContent = '$' + totalPrice.toFixed(2);

    // Display preview screenshot
    const canvas = document.getElementById('previewCanvas');
    const ctx = canvas.getContext('2d');

    function drawPreview(imageData) {
      if (!imageData) {
        console.warn('Order Summary: No preview image data available');
        // Fallback: Show placeholder if no screenshot (120% of original: 500 * 1.2 = 600)
        canvas.width = 500;
        canvas.height = 500;
        ctx.fillStyle = '#e0e0e0';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#666';
        ctx.font = '16px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('No preview available', canvas.width / 2, canvas.height / 2);
        canvas.style.width = '600px';
        canvas.style.height = '600px';
        return;
      }

      // Use screenshot from Flutter editor (stored in sessionStorage)
      const previewImg = new Image();
      previewImg.onload = function() {
        console.log('Order Summary: Preview image loaded successfully, dimensions:', previewImg.width, 'x', previewImg.height);
        // Set canvas size to match screenshot
        canvas.width = previewImg.width;
        canvas.height = previewImg.height;
        
        // Draw the screenshot
        ctx.drawImage(previewImg, 0, 0);
        
        // Scale canvas for display if needed (120% of original: 500 * 1.2 = 600)
        const maxDisplayWidth = 600;
        const maxDisplayHeight = 600;
        if (previewImg.width > maxDisplayWidth || previewImg.height > maxDisplayHeight) {
          const scaleX = maxDisplayWidth / previewImg.width;
          const scaleY = maxDisplayHeight / previewImg.height;
          const scale = Math.min(scaleX, scaleY);
          canvas.style.width = (canvas.width * scale) + 'px';
          canvas.style.height = (canvas.height * scale) + 'px';
        } else {
          // If image is smaller than max, scale to 120% of original size
          const scale = 1.2;
          canvas.style.width = (previewImg.width * scale) + 'px';
          canvas.style.height = (previewImg.height * scale) + 'px';
        }
        
        // Update container height to match canvas
        const container = canvas.parentElement;
        if (container) {
          container.style.height = 'auto';
        }
      };
      
      previewImg.onerror = function() {
        console.error('Order Summary: Failed to load preview screenshot from data URL');
        canvas.width = 500;
        canvas.height = 500;
        ctx.fillStyle = '#e0e0e0';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#666';
        ctx.font = '16px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('Failed to load preview image', canvas.width / 2, canvas.height / 2);
        canvas.style.width = '600px'; /* 120% of 500px */
        canvas.style.height = '600px';
      };
      
      previewImg.src = imageData;
    }

    // Try to get preview image from sessionStorage
    drawPreview(previewImage);

    // Continue button handler
    // Form validation
    function validateForm() {
      let isValid = true;
      
      // Validate nick name
      const nickNameInput = document.getElementById('customerNickName');
      const nickNameError = document.getElementById('nickNameError');
      const nickName = nickNameInput.value.trim();
      
      if (!nickName) {
        nickNameInput.classList.add('error');
        nickNameError.textContent = 'Please enter your nick name';
        nickNameError.classList.add('show');
        isValid = false;
      } else {
        nickNameInput.classList.remove('error');
        nickNameError.classList.remove('show');
      }
      
      // Validate email
      const emailInput = document.getElementById('customerEmail');
      const emailError = document.getElementById('emailError');
      const email = emailInput.value.trim();
      
      if (!email) {
        emailInput.classList.add('error');
        emailError.textContent = 'Please enter your email address';
        emailError.classList.add('show');
        isValid = false;
      } else {
        // Basic email validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          emailInput.classList.add('error');
          emailError.textContent = 'Please enter a valid email address';
          emailError.classList.add('show');
          isValid = false;
        } else {
          emailInput.classList.remove('error');
          emailError.classList.remove('show');
        }
      }
      
      // Validate phone
      const phoneInput = document.getElementById('customerPhone');
      const phoneError = document.getElementById('phoneError');
      const phone = phoneInput.value.trim();
      
      if (!phone) {
        phoneInput.classList.add('error');
        phoneError.textContent = 'Please enter your phone number';
        phoneError.classList.add('show');
        isValid = false;
      } else {
        phoneInput.classList.remove('error');
        phoneError.classList.remove('show');
      }
      
      // Validate address
      const addressInput = document.getElementById('customerAddress');
      const addressError = document.getElementById('addressError');
      const address = addressInput.value.trim();
      
      if (!address) {
        addressInput.classList.add('error');
        addressError.textContent = 'Please enter your address';
        addressError.classList.add('show');
        isValid = false;
      } else {
        addressInput.classList.remove('error');
        addressError.classList.remove('show');
      }
      
      return isValid;
    }
    
    // Remove error state on input
    document.getElementById('customerNickName').addEventListener('input', function() {
      this.classList.remove('error');
      document.getElementById('nickNameError').classList.remove('show');
    });
    
    document.getElementById('customerEmail').addEventListener('input', function() {
      this.classList.remove('error');
      document.getElementById('emailError').classList.remove('show');
    });
    
    document.getElementById('customerPhone').addEventListener('input', function() {
      this.classList.remove('error');
      document.getElementById('phoneError').classList.remove('show');
    });
    
    document.getElementById('customerAddress').addEventListener('input', function() {
      this.classList.remove('error');
      document.getElementById('addressError').classList.remove('show');
    });

    // Continue button handler
    const continueButton = document.getElementById('continueButton');
    continueButton.addEventListener('click', function() {
      // Validate form before proceeding
      if (!validateForm()) {
        console.log('Order Summary: Form validation failed');
        // Scroll to first error field
        const firstError = document.querySelector('.contact-form-input.error');
        if (firstError) {
          firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
          firstError.focus();
        }
        return;
      }
      
      // Get form values
      const nickName = document.getElementById('customerNickName').value.trim();
      const email = document.getElementById('customerEmail').value.trim();
      const phoneInput = document.getElementById('customerPhone').value.trim();
      // Combine +64 prefix with user input
      const phone = phoneInput ? '+64 ' + phoneInput : '';
      const address = document.getElementById('customerAddress').value.trim();
      const notes = document.getElementById('customerNotes').value.trim();
      
      // Map price to variant ID
      // 28 元 = 44509060038725
      // 35 元 = 44509060071493
      // 45 元 = 44509060104261
      let variantId = '';
      const priceNum = parseFloat(price);
      if (Math.abs(priceNum - 28) < 0.01) {
        variantId = '44509060038725';
      } else if (Math.abs(priceNum - 35) < 0.01) {
        variantId = '44509060071493';
      } else if (Math.abs(priceNum - 45) < 0.01) {
        variantId = '44509060104261';
      } else {
        console.error('Order Summary: Unknown price, cannot determine variant ID. Price:', priceNum);
        alert('Invalid price. Please contact support.');
        return;
      }
      
      // Build Shopify Cart Permalink URL
      // Format: /cart/variant_id:quantity?checkout[email]=...&checkout[shipping_address][first_name]=...
      const baseUrl = `/cart/${variantId}:${quantity}`;
      const params = new URLSearchParams();
      
      // Add checkout parameters
      if (email) {
        params.append('checkout[email]', email);
      }
      
      // Shipping address parameters
      if (nickName) {
        // Use nick name as first name (assuming it's a single name field)
        params.append('checkout[shipping_address][first_name]', nickName);
        // Set last name to empty or use a default
        params.append('checkout[shipping_address][last_name]', '');
      }
      
      if (address) {
        params.append('checkout[shipping_address][address1]', address);
      }
      
      // Set country to New Zealand (NZ) as default
      params.append('checkout[shipping_address][country]', 'NZ');
      
      // Phone number (remove +64 prefix for phone field, or keep it)
      if (phone) {
        params.append('checkout[shipping_address][phone]', phone);
      }
      
      // Optional fields - leave empty or set defaults
      // params.append('checkout[shipping_address][city]', '');
      // params.append('checkout[shipping_address][province]', '');
      // params.append('checkout[shipping_address][zip]', '');
      
      // Build final URL
      const checkoutUrl = baseUrl + (params.toString() ? '?' + params.toString() : '');
      
      console.log('Order Summary: Navigating to Shopify checkout:', checkoutUrl);
      console.log('Order Summary: Variant ID:', variantId, 'Quantity:', quantity);
      console.log('Order Summary: Customer data - Email:', email, 'Nick Name:', nickName, 'Phone:', phone, 'Address:', address);
      
      // Navigate to Shopify checkout
      window.location.href = checkoutUrl;
    });
  </script>
</body>
