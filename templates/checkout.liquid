<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout - PrintOra</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background-color: #E8F5E9;
      color: #333;
      line-height: 1.6;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }

    .header {
      background-color: #B8E6D3;
      padding: 20px;
      margin-bottom: 30px;
      border-radius: 8px;
    }

    .header h1 {
      color: #333;
      font-size: 28px;
    }

    .content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      margin-bottom: 30px;
    }

    @media (max-width: 968px) {
      .content {
        grid-template-columns: 1fr;
      }
    }

    .preview-section, .checkout-section {
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .section-title {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 20px;
      color: #333;
    }

    .preview-container {
      width: 100%;
      max-width: 500px;
      margin: 0 auto;
      position: relative;
      background-color: #D0D8E0;
      border-radius: 8px;
      overflow: hidden;
    }

    #previewCanvas {
      width: 100%;
      height: auto;
      display: block;
    }

    .order-summary {
      margin-top: 30px;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid #eee;
    }

    .summary-row:last-child {
      border-bottom: none;
    }

    .summary-label {
      color: #666;
      font-size: 16px;
    }

    .summary-value {
      font-weight: bold;
      color: #333;
      font-size: 16px;
    }

    .total-row {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 2px solid #B8E6D3;
      font-size: 20px;
    }

    .total-row .summary-label,
    .total-row .summary-value {
      font-size: 24px;
      color: #333;
    }

    .total-row .summary-value {
      color: #FF6B9D;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
      color: #333;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 12px;
      border: 2px solid #ddd;
      border-radius: 8px;
      font-size: 16px;
      transition: border-color 0.3s;
    }

    .form-group input:focus,
    .form-group select:focus {
      outline: none;
      border-color: #FF6B9D;
    }

    .payment-options {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .payment-option {
      display: flex;
      align-items: center;
      padding: 15px;
      border: 2px solid #ddd;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s;
    }

    .payment-option:hover {
      border-color: #FF6B9D;
      background-color: #FFF5F8;
    }

    .payment-option input[type="radio"] {
      width: auto;
      margin-right: 12px;
      cursor: pointer;
    }

    .payment-option label {
      margin: 0;
      cursor: pointer;
      flex: 1;
      font-weight: normal;
    }

    .pay-button {
      width: 100%;
      padding: 16px;
      background-color: #FF6B9D;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      transition: background-color 0.3s;
      margin-top: 20px;
    }

    .pay-button:hover {
      background-color: #E55A8A;
    }

    .pay-button:disabled {
      background-color: #ccc;
      cursor: not-allowed;
    }

    .error-message {
      color: #e74c3c;
      font-size: 14px;
      margin-top: 5px;
      display: none;
    }

    .error-message.show {
      display: block;
    }

    .loading {
      text-align: center;
      padding: 20px;
      color: #666;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Checkout</h1>
    </div>

    <div class="content">
      <!-- Preview Section -->
      <div class="preview-section">
        <h2 class="section-title">Preview</h2>
        <div class="preview-container">
          <canvas id="previewCanvas"></canvas>
        </div>
        <div class="order-summary">
          <div class="summary-row">
            <span class="summary-label">T-Shirt Color:</span>
            <span class="summary-value" id="tshirtColorDisplay">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Size:</span>
            <span class="summary-value" id="sizeDisplay">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Print Size:</span>
            <span class="summary-value" id="printSizeDisplay">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Quantity:</span>
            <span class="summary-value" id="quantityDisplay">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Unit Price:</span>
            <span class="summary-value" id="unitPriceDisplay">-</span>
          </div>
          <div class="summary-row total-row">
            <span class="summary-label">Total:</span>
            <span class="summary-value" id="totalPriceDisplay">-</span>
          </div>
        </div>
      </div>

      <!-- Checkout Form Section -->
      <div class="checkout-section">
        <h2 class="section-title">Payment Information</h2>
        <form id="checkoutForm">
          <div class="form-group">
            <label for="name">Name *</label>
            <input type="text" id="name" name="name" required>
            <div class="error-message" id="nameError">Please enter your name</div>
          </div>

          <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required>
            <div class="error-message" id="emailError">Please enter a valid email address</div>
          </div>

          <div class="form-group">
            <label>Payment Method *</label>
            <div class="payment-options">
              <div class="payment-option">
                <input type="radio" id="payment-card" name="payment" value="card" required>
                <label for="payment-card">Credit Card</label>
              </div>
              <div class="payment-option">
                <input type="radio" id="payment-paypal" name="payment" value="paypal">
                <label for="payment-paypal">PayPal</label>
              </div>
              <div class="payment-option">
                <input type="radio" id="payment-bank" name="payment" value="bank">
                <label for="payment-bank">Bank Transfer</label>
              </div>
            </div>
          </div>

          <button type="submit" class="pay-button" id="payButton">Pay Now</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Get URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const designId = urlParams.get('designId');
    const imageUrl = urlParams.get('imageUrl');
    const size = urlParams.get('size');
    const quantity = parseInt(urlParams.get('quantity') || '1');
    const price = parseFloat(urlParams.get('price') || '0');
    const type = urlParams.get('type');
    const printSize = urlParams.get('printSize');
    const tshirtColor = urlParams.get('tshirtColor');
    const imageX = parseFloat(urlParams.get('imageX') || '0');
    const imageY = parseFloat(urlParams.get('imageY') || '0');
    const imageScale = parseFloat(urlParams.get('imageScale') || '1');
    const imageRotation = parseFloat(urlParams.get('imageRotation') || '0');

    // Display order summary
    document.getElementById('tshirtColorDisplay').textContent = tshirtColor === 'black' ? 'Black' : 'White';
    document.getElementById('sizeDisplay').textContent = size || '-';
    document.getElementById('printSizeDisplay').textContent = printSize ? printSize.charAt(0).toUpperCase() + printSize.slice(1) : '-';
    document.getElementById('quantityDisplay').textContent = quantity.toString();
    document.getElementById('unitPriceDisplay').textContent = '$' + price.toFixed(2);
    document.getElementById('totalPriceDisplay').textContent = '$' + (price * quantity).toFixed(2);

    // Load and render preview
    const canvas = document.getElementById('previewCanvas');
    const ctx = canvas.getContext('2d');

    // Load t-shirt background image
    const tshirtImg = new Image();
    tshirtImg.crossOrigin = 'anonymous';
    tshirtImg.src = '/assets/editor/assets/' + (tshirtColor === 'black' ? 'tee_black.png' : 'tee_white.png');

    // Load user image
    const userImg = new Image();
    userImg.crossOrigin = 'anonymous';
    userImg.src = imageUrl || '';

    // Render preview when both images are loaded
    let tshirtLoaded = false;
    let userImgLoaded = false;
    const editorCanvasWidth = 800; // Default editor canvas width in Flutter

    function renderPreview() {
      if (!tshirtLoaded) {
        return;
      }

      // Set canvas size to match t-shirt image (maintain aspect ratio for display)
      const maxDisplayWidth = 500;
      const scale = tshirtImg.width > maxDisplayWidth ? maxDisplayWidth / tshirtImg.width : 1;
      canvas.width = tshirtImg.width;
      canvas.height = tshirtImg.height;

      // Draw t-shirt background
      ctx.drawImage(tshirtImg, 0, 0);

      // Only draw user image if it's loaded and URL is provided
      if (userImgLoaded && imageUrl && userImg.width > 0) {
        // Calculate editable area (same ratios as Flutter code)
        const editableAreaWidthRatio = 0.3;
        const editableAreaHeightRatio = 0.7;
        const editableAreaVerticalOffsetRatio = 0.04;

        const canvasWidth = canvas.width;
        const canvasHeight = canvas.height;
        const centerX = canvasWidth / 2;
        const centerY = canvasHeight / 2 + (canvasHeight * editableAreaVerticalOffsetRatio);

        // Calculate scale ratio between editor canvas and t-shirt image
        // Assuming editor canvas is 800px wide, scale to match t-shirt image width
        const scaleRatio = canvasWidth / editorCanvasWidth;

        // Calculate user image position and size
        // imageX and imageY are relative to editor canvas center
        const editorCenterX = editorCanvasWidth / 2;
        const editorCenterY = editorCanvasWidth * 0.54; // Approximate center Y in editor

        // Calculate absolute position on t-shirt image
        const userImgX = centerX + (imageX - editorCenterX) * scaleRatio;
        const userImgY = centerY + (imageY - editorCenterY) * scaleRatio;
        const userImgWidth = userImg.width * imageScale * scaleRatio;
        const userImgHeight = userImg.height * imageScale * scaleRatio;

        // Save context
        ctx.save();

        // Translate to image center, rotate, then draw
        ctx.translate(userImgX, userImgY);
        ctx.rotate(imageRotation);

        // Draw user image centered at origin
        ctx.drawImage(
          userImg,
          -userImgWidth / 2,
          -userImgHeight / 2,
          userImgWidth,
          userImgHeight
        );

        // Restore context
        ctx.restore();
      }

      // Scale canvas for display if needed
      if (scale < 1) {
        canvas.style.width = (canvas.width * scale) + 'px';
        canvas.style.height = (canvas.height * scale) + 'px';
      }
    }

    tshirtImg.onload = function() {
      tshirtLoaded = true;
      renderPreview();
    };

    tshirtImg.onerror = function() {
      console.error('Failed to load t-shirt image');
      canvas.width = 800;
      canvas.height = 1000;
      ctx.fillStyle = '#D0D8E0';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#666';
      ctx.font = '16px Arial';
      ctx.textAlign = 'center';
      ctx.fillText('Failed to load t-shirt image', canvas.width / 2, canvas.height / 2);
    };

    if (imageUrl) {
      userImg.onload = function() {
        userImgLoaded = true;
        renderPreview();
      };

      userImg.onerror = function() {
        console.error('Failed to load user image:', imageUrl);
        userImgLoaded = true; // Set to true so preview still renders without user image
        renderPreview();
      };
    } else {
      userImgLoaded = true;
      renderPreview();
    }

    // Form validation and submission
    const form = document.getElementById('checkoutForm');
    const nameInput = document.getElementById('name');
    const emailInput = document.getElementById('email');
    const payButton = document.getElementById('payButton');

    function validateEmail(email) {
      const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      return re.test(email);
    }

    function showError(elementId, message) {
      const errorElement = document.getElementById(elementId);
      errorElement.textContent = message;
      errorElement.classList.add('show');
    }

    function hideError(elementId) {
      const errorElement = document.getElementById(elementId);
      errorElement.classList.remove('show');
    }

    nameInput.addEventListener('blur', function() {
      if (nameInput.value.trim() === '') {
        showError('nameError', 'Please enter your name');
      } else {
        hideError('nameError');
      }
    });

    emailInput.addEventListener('blur', function() {
      if (emailInput.value.trim() === '') {
        showError('emailError', 'Please enter your email address');
      } else if (!validateEmail(emailInput.value)) {
        showError('emailError', 'Please enter a valid email address');
      } else {
        hideError('emailError');
      }
    });

    form.addEventListener('submit', function(e) {
      e.preventDefault();

      // Validate form
      let isValid = true;

      if (nameInput.value.trim() === '') {
        showError('nameError', 'Please enter your name');
        isValid = false;
      } else {
        hideError('nameError');
      }

      if (emailInput.value.trim() === '') {
        showError('emailError', 'Please enter your email address');
        isValid = false;
      } else if (!validateEmail(emailInput.value)) {
        showError('emailError', 'Please enter a valid email address');
        isValid = false;
      } else {
        hideError('emailError');
      }

      const paymentMethod = document.querySelector('input[name="payment"]:checked');
      if (!paymentMethod) {
        isValid = false;
      }

      if (!isValid) {
        return;
      }

      // Disable button
      payButton.disabled = true;
      payButton.textContent = 'Processing...';

      // Collect form data
      const formData = {
        designId: designId,
        name: nameInput.value.trim(),
        email: emailInput.value.trim(),
        paymentMethod: paymentMethod.value,
        size: size,
        quantity: quantity,
        price: price,
        totalPrice: price * quantity,
        type: type,
        printSize: printSize,
        tshirtColor: tshirtColor,
        imageX: imageX,
        imageY: imageY,
        imageScale: imageScale,
        imageRotation: imageRotation,
        imageUrl: imageUrl
      };

      // TODO: Send data to backend/payment processor
      console.log('Checkout data:', formData);

      // Simulate payment processing
      setTimeout(function() {
        alert('Payment processed successfully!\n\nOrder Details:\n' +
          'Name: ' + formData.name + '\n' +
          'Email: ' + formData.email + '\n' +
          'Payment Method: ' + formData.paymentMethod + '\n' +
          'Total: $' + formData.totalPrice.toFixed(2) + '\n\n' +
          'This is a demo. In production, this would process the actual payment.');
        
        payButton.disabled = false;
        payButton.textContent = 'Pay Now';
      }, 2000);
    });
  </script>
</body>
</html>

