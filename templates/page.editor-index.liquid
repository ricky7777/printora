{% layout none %}

{%- comment -%}
  Flutter Editor Index Page
  Converted from assets/editor/index.html
  IMPORTANT: Shopify assets directory is FLAT - no subdirectories allowed!
  All resources are in assets root with editor- prefix
{%- endcomment -%}

<!DOCTYPE html>
<html>
<head>
  {%- comment -%}
    Calculate base href for Flutter app
    Since files are in assets root, base href should point to assets root
  {%- endcomment -%}
  {%- assign sample_asset = 'editor-flutter_bootstrap.js' | asset_url -%}
  {%- assign sample_clean = sample_asset | split: '?' | first -%}
  {%- assign editor_base = sample_clean | split: 'editor-flutter_bootstrap.js' | first -%}
  <base href="{{ editor_base }}">
  
  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="description" content="PrintOra T-Shirt Editor">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- iOS meta tags & icons -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="apple-mobile-web-app-title" content="PrintOra Editor">
  <link rel="apple-touch-icon" href="{{ 'editor-icon-192.png' | asset_url }}">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="{{ 'editor-favicon.png' | asset_url }}"/>

  <title>PrintOra T-Shirt Editor</title>
  <link rel="manifest" href="{{ 'editor-manifest.json' | asset_url }}">
  
  <script>
    // CRITICAL: This script must run BEFORE Flutter bootstrap loads
    // Preserve URL parameters and set up resource path rewriting
    (function() {
      'use strict';
      
      // Get current URL parameters
      const urlParams = new URLSearchParams(window.location.search);
      const price = urlParams.get('price');
      const type = urlParams.get('type');
      
      // Store in sessionStorage for Flutter app to access
      if (price) {
        sessionStorage.setItem('editor_price', price);
      }
      if (type) {
        sessionStorage.setItem('editor_type', type);
      }
      
      // Resource path mapping for Shopify flat assets structure
      // Map Flutter's relative paths to editor- prefixed files
      const resourceMap = {
        'main.dart.js': 'editor-main.dart.js',
        'flutter_service_worker.js': 'editor-flutter_service_worker.js',
        'canvaskit/canvaskit.js': 'editor-canvaskit.js',
        'canvaskit/canvaskit.wasm': 'editor-canvaskit.wasm',
        'canvaskit/chromium/canvaskit.js': 'editor-canvaskit-chromium.js',
        'canvaskit/chromium/canvaskit.wasm': 'editor-canvaskit-chromium.wasm',
        'skwasm.js': 'editor-skwasm.js',
        'skwasm.wasm': 'editor-skwasm.wasm',
        'skwasm_heavy.js': 'editor-skwasm-heavy.js',
        'skwasm_heavy.wasm': 'editor-skwasm-heavy.wasm',
        'assets/FontManifest.json': 'editor-font-manifest.json',
        'assets/AssetManifest.bin.json': 'editor-asset-manifest.json',
        'assets/tee_black.png': 'editor-tee-black.png',
        'assets/tee_white.png': 'editor-tee-white.png',
        'assets/printora_logo.png': 'editor-printora-logo.png',
        'assets/size_chart.png': 'editor-size-chart.png',
        'assets/fonts/MaterialIcons-Regular.otf': 'editor-material-icons.otf',
        'assets/shaders/ink_sparkle.frag': 'editor-ink-sparkle.frag',
        'assets/shaders/stretch_effect.frag': 'editor-stretch-effect.frag',
        'assets/packages/cupertino_icons/assets/CupertinoIcons.ttf': 'editor-cupertino-icons.ttf',
        'icons/Icon-192.png': 'editor-icon-192.png',
        'icons/Icon-512.png': 'editor-icon-512.png',
        'icons/Icon-maskable-192.png': 'editor-icon-maskable-192.png',
        'icons/Icon-maskable-512.png': 'editor-icon-maskable-512.png',
        'favicon.png': 'editor-favicon.png',
        'manifest.json': 'editor-manifest.json'
      };
      
      // Helper function to rewrite resource paths
      function rewriteResourcePath(url) {
        if (!url || typeof url !== 'string') return url;
        
        // Skip if already has editor- prefix
        if (url.includes('editor-')) return url;
        
        // Skip external URLs
        if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('//')) {
          // But still check if it's our domain and needs rewriting
          try {
            const urlObj = new URL(url);
            const pathname = urlObj.pathname;
            // Extract just the filename/path from the URL
            const pathParts = pathname.split('/');
            const filename = pathParts[pathParts.length - 1];
            
            // Check if this filename needs mapping
            for (const [originalPath, mappedPath] of Object.entries(resourceMap)) {
              const originalFilename = originalPath.split('/').pop();
              if (filename === originalFilename && !url.includes('editor-')) {
                const newPath = pathname.replace(originalFilename, mappedPath.split('/').pop());
                urlObj.pathname = newPath;
                console.log('Rewriting external URL:', url, '->', urlObj.toString());
                return urlObj.toString();
              }
            }
          } catch (e) {
            // Not a valid URL, continue with original logic
          }
          return url;
        }
        
        // Handle relative paths
        for (const [originalPath, mappedPath] of Object.entries(resourceMap)) {
          // Match the path (with or without leading slash, with or without query params)
          if (url.includes(originalPath) && !url.includes('editor-')) {
            const newUrl = url.replace(originalPath, mappedPath);
            console.log('Rewriting resource path:', url, '->', newUrl);
            return newUrl;
          }
          
          // Also try matching just the filename
          const originalFilename = originalPath.split('/').pop();
          const mappedFilename = mappedPath.split('/').pop();
          if (url.endsWith(originalFilename) && !url.includes('editor-')) {
            const newUrl = url.replace(originalFilename, mappedFilename);
            console.log('Rewriting filename:', url, '->', newUrl);
            return newUrl;
          }
        }
        
        return url;
      }
      
      // Intercept fetch requests - MUST be set up early
      const originalFetch = window.fetch;
      window.fetch = function(input, init) {
        if (typeof input === 'string') {
          const rewritten = rewriteResourcePath(input);
          if (rewritten !== input) {
            return originalFetch.call(this, rewritten, init);
          }
        } else if (input && typeof input === 'object' && input.url) {
          const rewritten = rewriteResourcePath(input.url);
          if (rewritten !== input.url) {
            return originalFetch.call(this, { ...input, url: rewritten }, init);
          }
        }
        return originalFetch.call(this, input, init);
      };
      
      // Intercept XMLHttpRequest
      const originalXHROpen = XMLHttpRequest.prototype.open;
      XMLHttpRequest.prototype.open = function(method, url, ...rest) {
        const rewritten = rewriteResourcePath(url);
        return originalXHROpen.call(this, method, rewritten, ...rest);
      };
      
      // Intercept Service Worker registration (critical for flutter_service_worker.js)
      const originalServiceWorkerRegister = navigator.serviceWorker.register.bind(navigator.serviceWorker);
      if (navigator.serviceWorker && navigator.serviceWorker.register) {
        navigator.serviceWorker.register = function(scriptURL, options) {
          const rewritten = rewriteResourcePath(scriptURL);
          console.log('Rewriting Service Worker URL:', scriptURL, '->', rewritten);
          return originalServiceWorkerRegister(rewritten, options);
        };
      }
      
      // Intercept script tag creation
      const originalCreateElement = document.createElement.bind(document);
      document.createElement = function(tagName, options) {
        const element = originalCreateElement(tagName, options);
        if (tagName.toLowerCase() === 'script') {
          // Intercept setAttribute
          const originalSetAttribute = element.setAttribute.bind(element);
          element.setAttribute = function(name, value) {
            if (name === 'src' && typeof value === 'string') {
              const rewritten = rewriteResourcePath(value);
              return originalSetAttribute('src', rewritten);
            }
            return originalSetAttribute(name, value);
          };
          
          // Intercept src property setter
          let srcValue = '';
          Object.defineProperty(element, 'src', {
            set: function(value) {
              srcValue = value;
              const rewritten = rewriteResourcePath(value);
              element.setAttribute('src', rewritten);
            },
            get: function() {
              return element.getAttribute('src') || srcValue;
            },
            configurable: true,
            enumerable: true
          });
        }
        return element;
      };
      
      // Debug: Log base href
      const baseElement = document.querySelector('base');
      if (baseElement) {
        console.log('Flutter base href:', baseElement.href);
      }
      
      console.log('Resource path rewriting initialized');
    })();
  </script>
</head>
<body>
  <script src="{{ 'editor-flutter_bootstrap.js' | asset_url }}" async></script>
</body>
</html>

