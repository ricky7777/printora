{% comment %}
  Checkout Page - Standalone sub-page
  Does not affect the main theme
{% endcomment %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/x-icon" href="{{ 'favicon.ico' | asset_url }}">
  <title>{{ page.title }} - {{ shop.name }}</title>
  <link rel="stylesheet" href="{{ 'checkout.css' | asset_url }}">
</head>
<body class="checkout-page-body">
  <div class="checkout-page">
    <div class="checkout-container">
      <!-- Left Side: Preview -->
      <div class="checkout-preview-section">
        <h2 class="section-title">Preview</h2>
        <div class="preview-wrapper">
          <canvas id="previewCanvas"></canvas>
        </div>
        
        <div class="order-summary">
          <div class="summary-row">
            <span class="summary-label">T-Shirt Color:</span>
            <span class="summary-value" id="tshirtColorDisplay">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Size:</span>
            <span class="summary-value" id="sizeDisplay">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Print Size:</span>
            <span class="summary-value" id="printSizeDisplay">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Quantity:</span>
            <span class="summary-value" id="quantityDisplay">-</span>
          </div>
          <div class="summary-row">
            <span class="summary-label">Unit Price:</span>
            <span class="summary-value" id="unitPriceDisplay">-</span>
          </div>
          <div class="summary-row total-row">
            <span class="summary-label">Total:</span>
            <span class="summary-value" id="totalPriceDisplay">-</span>
          </div>
        </div>
      </div>

      <!-- Right Side: Payment Form -->
      <div class="checkout-form-section">
        <h2 class="section-title">Payment Information</h2>
        <form id="checkoutForm">
          <div class="form-group">
            <label for="name">Name *</label>
            <input type="text" id="name" name="name" required>
            <div class="error-message" id="nameError">Please enter your name</div>
          </div>

          <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required>
            <div class="error-message" id="emailError">Please enter a valid email address</div>
          </div>

          <div class="form-group">
            <label>Payment Method *</label>
            <div class="payment-options">
              <div class="payment-option">
                <input type="radio" id="payment-card" name="payment" value="card" required>
                <label for="payment-card">Credit Card</label>
              </div>
              <div class="payment-option">
                <input type="radio" id="payment-paypal" name="payment" value="paypal">
                <label for="payment-paypal">PayPal</label>
              </div>
              <div class="payment-option">
                <input type="radio" id="payment-bank" name="payment" value="bank">
                <label for="payment-bank">Bank Transfer</label>
              </div>
            </div>
          </div>

          <button type="submit" class="pay-button" id="payButton">Pay Now</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Set asset base URL for JavaScript
    window.assetBaseUrl = '{{ "tee_black.png" | asset_url }}'.replace('tee_black.png', '');
  </script>
  <script src="{{ 'checkout.js' | asset_url }}" defer></script>
</body>
</html>
