{% layout none %}

{%- comment -%}
  Flutter New Editor Page
  Converted from assets/editor/index.html
  IMPORTANT: Shopify assets directory is FLAT - no subdirectories allowed!
  All resources are in assets root with editor- prefix
  Path: /pages/new-editor
{%- endcomment -%}

<!DOCTYPE html>
<html>
<head>
  {%- comment -%}
    Calculate base href for Flutter app
    Since files are in assets root, base href should point to assets root
  {%- endcomment -%}
  {%- assign sample_asset = 'editor-flutter_bootstrap.js' | asset_url -%}
  {%- assign sample_clean = sample_asset | split: '?' | first -%}
  {%- assign editor_base = sample_clean | split: 'editor-flutter_bootstrap.js' | first -%}
  <base href="{{ editor_base }}">
  
  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="description" content="PrintOra T-Shirt Editor">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- iOS meta tags & icons -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="apple-mobile-web-app-title" content="PrintOra Editor">
  <link rel="apple-touch-icon" href="{{ 'editor-icon-192.png' | asset_url }}">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="{{ 'editor-favicon.png' | asset_url }}"/>

  <title>PrintOra T-Shirt Editor</title>
  <link rel="manifest" href="{{ 'editor-manifest.json' | asset_url }}">
  
  <script>
    // CRITICAL: This script must run BEFORE Flutter bootstrap loads
    // Preserve URL parameters and set up resource path rewriting
    (function() {
      'use strict';
      
      // Get current URL parameters
      const urlParams = new URLSearchParams(window.location.search);
      const price = urlParams.get('price');
      const type = urlParams.get('type');
      
      // Store in sessionStorage for Flutter app to access
      if (price) {
        sessionStorage.setItem('editor_price', price);
      }
      if (type) {
        sessionStorage.setItem('editor_type', type);
      }
      
      // Resource path mapping for Shopify flat assets structure
      // Map Flutter's relative paths to editor- prefixed files
      const resourceMap = {
        'main.dart.js': 'editor-main.dart.js',
        'flutter_service_worker.js': 'editor-flutter_service_worker.js',
        'canvaskit/canvaskit.js': 'editor-canvaskit.js',
        'canvaskit/canvaskit.wasm': 'editor-canvaskit.wasm',
        'canvaskit/chromium/canvaskit.js': 'editor-canvaskit-chromium.js',
        'canvaskit/chromium/canvaskit.wasm': 'editor-canvaskit-chromium.wasm',
        'skwasm.js': 'editor-skwasm.js',
        'skwasm.wasm': 'editor-skwasm.wasm',
        'skwasm_heavy.js': 'editor-skwasm-heavy.js',
        'skwasm_heavy.wasm': 'editor-skwasm-heavy.wasm',
        'assets/FontManifest.json': 'editor-font-manifest.json',
        'assets/AssetManifest.bin.json': 'editor-asset-manifest.json',
        'assets/tee_black.png': 'editor-tee-black.png',
        'assets/tee_white.png': 'editor-tee-white.png',
        'assets/printora_logo.png': 'editor-printora-logo.png',
        'assets/size_chart.png': 'editor-size-chart.png',
        'assets/fonts/MaterialIcons-Regular.otf': 'editor-material-icons.otf',
        'assets/shaders/ink_sparkle.frag': 'editor-ink-sparkle.frag',
        'assets/shaders/stretch_effect.frag': 'editor-stretch-effect.frag',
        'assets/packages/cupertino_icons/assets/CupertinoIcons.ttf': 'editor-cupertino-icons.ttf',
        'icon-192.png': 'editor-icon-192.png',
        'icon-512.png': 'editor-icon-512.png',
        'icon-maskable-192.png': 'editor-icon-maskable-192.png',
        'icon-maskable-192.png': 'editor-icon-maskable-192.png',
        'icon-maskable-512.png': 'editor-icon-maskable-512.png',
        'icon-maskable-512.png': 'editor-icon-maskable-512.png',
        'favicon.png': 'editor-favicon.png',
        'manifest.json': 'editor-manifest.json'
      };
      
      // Helper function to rewrite resource paths
      function rewriteResourcePath(url) {
        if (!url || typeof url !== 'string') return url;
        
        // Skip if already has editor- prefix
        if (url.includes('editor-')) return url;
        
        // Handle absolute URLs (including CDN paths)
        if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('//')) {
          try {
            const urlObj = new URL(url, window.location.origin);
            
            // CRITICAL: Skip external domains (like gstatic.com) - don't rewrite external URLs
            const currentHost = window.location.hostname;
            const urlHost = urlObj.hostname;
            if (urlHost !== currentHost && urlHost !== '127.0.0.1' && urlHost !== 'localhost') {
              // External URL - don't rewrite
              return url;
            }
            
            const pathname = urlObj.pathname;
            
            // Extract filename from pathname
            const pathParts = pathname.split('/').filter(p => p);
            const filename = pathParts[pathParts.length - 1];
            
            // Check if this filename needs mapping
            for (const [originalPath, mappedPath] of Object.entries(resourceMap)) {
              const originalFilename = originalPath.split('/').pop();
              const mappedFilename = mappedPath.split('/').pop();
              
              // Match by filename (most reliable)
              if (filename === originalFilename && !url.includes('editor-')) {
                // Replace the filename in the path
                const newPathname = pathname.replace(new RegExp(originalFilename + '(\\?|$|#)', 'g'), mappedFilename + '$1');
                urlObj.pathname = newPathname;
                const rewritten = urlObj.toString();
                console.log('Rewriting absolute URL:', url, '->', rewritten);
                return rewritten;
              }
            }
          } catch (e) {
            console.warn('Error parsing URL:', url, e);
          }
          return url;
        }
        
        // Handle relative paths (including those resolved by base href)
        // First, try to resolve relative URL to see the actual path
        try {
          const resolvedUrl = new URL(url, document.baseURI || window.location.href);
          const pathname = resolvedUrl.pathname;
          const filename = pathname.split('/').pop();
          
          // Check if filename needs mapping
          for (const [originalPath, mappedPath] of Object.entries(resourceMap)) {
            const originalFilename = originalPath.split('/').pop();
            const mappedFilename = mappedPath.split('/').pop();
            
            if (filename === originalFilename && !url.includes('editor-')) {
              // Handle assets/ prefix removal: if original path has assets/ but mapped doesn't,
              // remove assets/ from the URL before replacing
              let newUrl = url;
              
              // If original path starts with "assets/" but mapped path doesn't, remove "assets/" prefix
              if (originalPath.startsWith('assets/') && !mappedPath.startsWith('assets/')) {
                // Remove "assets/" prefix from URL if present
                newUrl = newUrl.replace(/^assets\//, '').replace(/\/assets\//, '/');
              }
              
              // Replace filename
              newUrl = newUrl.replace(new RegExp(originalFilename + '(\\?|$|#)', 'g'), mappedFilename + '$1');
              console.log('Rewriting relative URL:', url, '->', newUrl);
              return newUrl;
            }
          }
        } catch (e) {
          // Fallback to string matching
        }
        
        // Fallback: direct string matching for relative paths
        for (const [originalPath, mappedPath] of Object.entries(resourceMap)) {
          // Match the path (with or without leading slash, with or without query params)
          if (url.includes(originalPath) && !url.includes('editor-')) {
            let newUrl = url;
            
            // Handle assets/ prefix removal
            if (originalPath.startsWith('assets/') && !mappedPath.startsWith('assets/')) {
              // Remove "assets/" prefix from URL if present
              newUrl = newUrl.replace(/^assets\//, '').replace(/\/assets\//, '/');
            }
            
            newUrl = newUrl.replace(originalPath, mappedPath);
            console.log('Rewriting resource path (fallback):', url, '->', newUrl);
            return newUrl;
          }
          
          // Also try matching just the filename
          const originalFilename = originalPath.split('/').pop();
          const mappedFilename = mappedPath.split('/').pop();
          if (url.endsWith(originalFilename) || url.includes('/' + originalFilename) && !url.includes('editor-')) {
            let newUrl = url;
            
            // Handle assets/ prefix removal for filename-only matches
            if (originalPath.startsWith('assets/') && !mappedPath.startsWith('assets/')) {
              newUrl = newUrl.replace(/^assets\//, '').replace(/\/assets\//, '/');
            }
            
            newUrl = newUrl.replace(new RegExp(originalFilename + '(\\?|$|#)', 'g'), mappedFilename + '$1');
            console.log('Rewriting filename (fallback):', url, '->', newUrl);
            return newUrl;
          }
        }
        
        return url;
      }
      
      // Intercept fetch requests - MUST be set up early
      const originalFetch = window.fetch;
      window.fetch = function(input, init) {
        if (typeof input === 'string') {
          const rewritten = rewriteResourcePath(input);
          if (rewritten !== input) {
            return originalFetch.call(this, rewritten, init);
          }
        } else if (input && typeof input === 'object' && input.url) {
          const rewritten = rewriteResourcePath(input.url);
          if (rewritten !== input.url) {
            return originalFetch.call(this, { ...input, url: rewritten }, init);
          }
        }
        return originalFetch.call(this, input, init);
      };
      
      // Intercept XMLHttpRequest
      const originalXHROpen = XMLHttpRequest.prototype.open;
      XMLHttpRequest.prototype.open = function(method, url, ...rest) {
        const rewritten = rewriteResourcePath(url);
        return originalXHROpen.call(this, method, rewritten, ...rest);
      };
      
      // Intercept Service Worker registration (critical for flutter_service_worker.js)
      const originalServiceWorkerRegister = navigator.serviceWorker.register.bind(navigator.serviceWorker);
      if (navigator.serviceWorker && navigator.serviceWorker.register) {
        navigator.serviceWorker.register = function(scriptURL, options) {
          if (typeof scriptURL === 'string') {
            const rewritten = rewriteResourcePath(scriptURL);
            if (rewritten !== scriptURL) {
              console.log('Rewriting Service Worker URL:', scriptURL, '->', rewritten);
              return originalServiceWorkerRegister(rewritten, options);
            }
          }
          return originalServiceWorkerRegister(scriptURL, options);
        };
      }
      
      // Intercept script tag creation
      const originalCreateElement = document.createElement.bind(document);
      document.createElement = function(tagName, options) {
        const element = originalCreateElement(tagName, options);
        if (tagName.toLowerCase() === 'script') {
          // Intercept setAttribute
          const originalSetAttribute = element.setAttribute.bind(element);
          element.setAttribute = function(name, value) {
            if (name === 'src' && typeof value === 'string') {
              const rewritten = rewriteResourcePath(value);
              return originalSetAttribute('src', rewritten);
            }
            return originalSetAttribute(name, value);
          };
          
          // Intercept src property setter
          let srcValue = '';
          Object.defineProperty(element, 'src', {
            set: function(value) {
              srcValue = value;
              const rewritten = rewriteResourcePath(value);
              element.setAttribute('src', rewritten);
            },
            get: function() {
              return element.getAttribute('src') || srcValue;
            },
            configurable: true,
            enumerable: true
          });
        }
        return element;
      };
      
      // Debug: Log base href
      const baseElement = document.querySelector('base');
      if (baseElement) {
        console.log('Flutter base href:', baseElement.href);
      }
      
      // Intercept navigation to order-summary page
      // Flutter app may try to navigate to /assets/order-summary.html in local dev
      // We'll intercept and redirect to /pages/order-summary
      (function() {
        // Function to rewrite order-summary URLs
        function rewriteOrderSummaryUrl(url) {
          if (typeof url !== 'string') return url;
          
          // Check if it's trying to navigate to order-summary
          if (url.includes('order-summary') || url.includes('order_summary')) {
            // Extract query parameters
            let queryString = '';
            if (url.includes('?')) {
              queryString = url.substring(url.indexOf('?'));
            } else {
              // Try to parse as URL
              try {
                const urlObj = new URL(url, window.location.origin);
                queryString = urlObj.search;
              } catch (e) {
                // If parsing fails, check if it's a relative path with query
                const queryIndex = url.indexOf('?');
                if (queryIndex !== -1) {
                  queryString = url.substring(queryIndex);
                }
              }
            }
            
            // Redirect to /pages/order-summary with same parameters
            const targetUrl = '/pages/order-summary' + queryString;
            console.log('Intercepting navigation to order-summary:', url, '->', targetUrl);
            return targetUrl;
          }
          return url;
        }
        
        // Method 1: Intercept location.href setter (most common)
        try {
          const locationDescriptor = Object.getOwnPropertyDescriptor(window.location, 'href') || 
                                     Object.getOwnPropertyDescriptor(Object.getPrototypeOf(window.location), 'href');
          
          if (locationDescriptor && locationDescriptor.set) {
            const originalSetter = locationDescriptor.set;
            
            Object.defineProperty(window.location, 'href', {
              set: function(value) {
                const rewritten = rewriteOrderSummaryUrl(value);
                originalSetter.call(window.location, rewritten);
              },
              get: function() {
                return window.location.href;
              },
              configurable: true,
              enumerable: true
            });
            console.log('Navigation interceptor (location.href) installed');
          }
        } catch (e) {
          console.warn('Failed to intercept location.href:', e);
        }
        
        // Method 2: Intercept window.location assignment (backup)
        try {
          const windowLocationDescriptor = Object.getOwnPropertyDescriptor(window, 'location');
          if (windowLocationDescriptor && windowLocationDescriptor.set) {
            const originalWindowLocationSetter = windowLocationDescriptor.set;
            Object.defineProperty(window, 'location', {
              set: function(value) {
                const rewritten = rewriteOrderSummaryUrl(value);
                originalWindowLocationSetter.call(window, rewritten);
              },
              get: function() {
                return window.location;
              },
              configurable: true,
              enumerable: true
            });
            console.log('Navigation interceptor (window.location) installed');
          }
        } catch (e) {
          console.warn('Failed to intercept window.location:', e);
        }
        
        // Method 3: Use beforeunload as fallback (monitor navigation)
        window.addEventListener('beforeunload', function(e) {
          const currentHref = window.location.href;
          if (currentHref.includes('order-summary') || currentHref.includes('order_summary')) {
            if (currentHref.includes('/assets/order-summary.html')) {
              // Extract query parameters
              const queryString = currentHref.includes('?') ? currentHref.substring(currentHref.indexOf('?')) : '';
              const targetUrl = '/pages/order-summary' + queryString;
              console.log('beforeunload: Redirecting to', targetUrl);
              // Note: beforeunload doesn't allow navigation, but we can use it for logging
            }
          }
        });
        
        // Method 4: Intercept history.pushState and history.replaceState
        const originalPushState = history.pushState;
        const originalReplaceState = history.replaceState;
        
        history.pushState = function(...args) {
          if (args.length > 2 && typeof args[2] === 'string') {
            const rewritten = rewriteOrderSummaryUrl(args[2]);
            if (rewritten !== args[2]) {
              args[2] = rewritten;
              console.log('Intercepted history.pushState:', args[2]);
            }
          }
          return originalPushState.apply(history, args);
        };
        
        history.replaceState = function(...args) {
          if (args.length > 2 && typeof args[2] === 'string') {
            const rewritten = rewriteOrderSummaryUrl(args[2]);
            if (rewritten !== args[2]) {
              args[2] = rewritten;
              console.log('Intercepted history.replaceState:', args[2]);
            }
          }
          return originalReplaceState.apply(history, args);
        };
        
        // Method 5: Monitor popstate events (for browser back/forward)
        window.addEventListener('popstate', function(e) {
          const currentHref = window.location.href;
          if (currentHref.includes('/assets/order-summary.html')) {
            const queryString = currentHref.includes('?') ? currentHref.substring(currentHref.indexOf('?')) : '';
            const targetUrl = '/pages/order-summary' + queryString;
            console.log('popstate: Redirecting to', targetUrl);
            window.location.href = targetUrl;
          }
        });
        
        // Method 6: Periodic check as last resort (check every 100ms)
        let lastHref = window.location.href;
        setInterval(function() {
          const currentHref = window.location.href;
          if (currentHref !== lastHref) {
            lastHref = currentHref;
            if (currentHref.includes('/assets/order-summary.html')) {
              const queryString = currentHref.includes('?') ? currentHref.substring(currentHref.indexOf('?')) : '';
              const targetUrl = '/pages/order-summary' + queryString;
              console.log('Periodic check: Redirecting to', targetUrl);
              window.location.replace(targetUrl);
            }
          }
        }, 100);
        
        console.log('All navigation interceptors installed');
      })();
      
      console.log('Resource path rewriting initialized');
    })();
  </script>
</head>
<body>
  <script src="{{ 'editor-flutter_bootstrap.js' | asset_url }}" async></script>
</body>
</html>

