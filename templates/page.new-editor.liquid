{% layout none %}

{%- comment -%}
  PrintOra T-Shirt Editor Page
  Pure JavaScript implementation (no Flutter)
  Path: /pages/new-editor
{%- endcomment -%}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PrintOra T-Shirt Editor</title>
  
  <link rel="stylesheet" href="{{ 'editor.css' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/interactjs/dist/interact.min.js"></script>
  <style>
    .header__logo {
      display: flex;
      align-items: center;
    }
    
    .header__logo-image {
      max-height: 2.4rem;
      max-width: 9rem;
      height: auto;
      width: auto;
      object-fit: contain;
    }
    
    @media screen and (max-width: 767px) {
      .header__logo-image {
        max-height: 1.8rem;
        max-width: 7.2rem;
      }
    }
    
    .header-nav-link {
      color: #1F2937;
      font-weight: 300;
      font-size: 1rem;
      text-decoration: none;
      transition: opacity 0.3s ease;
      cursor: pointer;
    }
    
    .header-nav-link:hover {
      opacity: 0.8;
    }
    
    .header__cart {
      display: flex;
      align-items: center;
    }
    
    .header__cart-image {
      width: 2.4rem;
      height: 2.4rem;
      object-fit: contain;
    }
    
    @media screen and (max-width: 767px) {
      .header__cart-image {
        width: 2rem;
        height: 2rem;
      }
    }
    
    .header__back-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.4rem;
      height: 2.4rem;
      background-color: transparent;
      border: 1.5px solid #1F2937;
      border-radius: 50%;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-right: 1rem;
      padding: 0;
    }
    
    .header__back-button:hover {
      background-color: rgba(31, 41, 55, 0.1);
      transform: scale(1.05);
    }
    
    .header__back-button svg {
      width: 1.2rem;
      height: 1.2rem;
      stroke: #1F2937;
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    
    @media screen and (max-width: 767px) {
      .header__back-button {
        width: 2rem;
        height: 2rem;
        margin-right: 0.75rem;
      }
      
      .header__back-button svg {
        width: 1rem;
        height: 1rem;
      }
    }
    
    .bg-mint {
      background-color: #A8E6CF;
    }
  </style>
  
  <script>
    // DEBUG MODE: Set to true to prevent navigation and only log
    const DEBUG_MODE = true; // Change to false to enable actual navigation
    
    // Checkout navigation interceptor (for debugging)
    (function setupCheckoutInterceptor() {
      function rewriteOrderSummaryUrl(url) {
        if (typeof url !== 'string') return url;
        
        if (url.includes('order-summary') || url.includes('order_summary')) {
          let queryString = '';
          if (url.includes('?')) {
            queryString = url.substring(url.indexOf('?'));
          } else {
            try {
              const urlObj = new URL(url, window.location.origin);
              queryString = urlObj.search;
            } catch (e) {
              const queryIndex = url.indexOf('?');
              if (queryIndex !== -1) {
                queryString = url.substring(queryIndex);
              }
            }
          }
          
          const targetUrl = '/pages/order-summary' + queryString;
          
          console.log('=== CHECKOUT NAVIGATION INTERCEPTED ===');
          console.log('📍 原始 URL:', url);
          console.log('🎯 目標 URL:', targetUrl);
          console.log('📋 Query 參數:', queryString);
          
          if (DEBUG_MODE) {
            console.log('🚫 DEBUG MODE: 已阻止導航（僅記錄日誌）');
            return window.location.href; // Return current URL to prevent navigation
          } else {
            console.log('✅ 導航到:', targetUrl);
            return targetUrl;
          }
        }
        return url;
      }
      
      // Intercept location.href
      try {
        const locationDescriptor = Object.getOwnPropertyDescriptor(window.location, 'href') || 
                                   Object.getOwnPropertyDescriptor(Object.getPrototypeOf(window.location), 'href');
        
        if (locationDescriptor && locationDescriptor.set) {
          if (locationDescriptor.configurable === false) {
            console.log('[INTERCEPTOR] location.href is not configurable, will try later');
          } else {
            const originalSetter = locationDescriptor.set;
            
            try {
              Object.defineProperty(window.location, 'href', {
                set: function(value) {
                  console.log('[INTERCEPTOR] location.href setter called with:', value);
                  const rewritten = rewriteOrderSummaryUrl(value);
                  if (rewritten !== value) {
                    console.log('[INTERCEPTOR] URL rewritten from', value, 'to', rewritten);
                  }
                  if (!DEBUG_MODE) {
                    originalSetter.call(window.location, rewritten);
                  } else {
                    console.log('[INTERCEPTOR] DEBUG MODE: Navigation blocked');
                  }
                },
                get: function() {
                  return window.location.href;
                },
                configurable: true,
                enumerable: true
              });
              console.log('[INTERCEPTOR] Checkout navigation interceptor installed (location.href)');
            } catch (defineError) {
              if (defineError.message && defineError.message.includes('Cannot redefine property')) {
                console.log('[INTERCEPTOR] location.href already intercepted');
              } else {
                console.warn('[INTERCEPTOR] Failed to intercept location.href:', defineError);
              }
            }
          }
        }
      } catch (e) {
        if (e.message && e.message.includes('Cannot redefine property')) {
          console.log('[INTERCEPTOR] location.href already intercepted by another script');
        } else {
          console.warn('[INTERCEPTOR] Failed to intercept location.href:', e);
        }
      }
    })();
  </script>
</head>
<body class="editor-page-body">
  <!-- Header -->
  <header class="fixed top-0 w-full bg-mint z-50">
    <div class="max-w-7xl mx-auto px-8 py-6">
      <div class="flex items-center justify-between">
        <!-- Left side: Back button and Logo -->
        <div class="flex items-center">
          <!-- Back Button -->
          <button class="header__back-button" id="backButton" aria-label="返回首頁">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
          </button>
          
          <!-- Logo -->
          <div class="header__logo">
            <a href="/">
              <img
                src="{{ 'printora_logo.png' | asset_url }}"
                alt="PrintOra"
                class="header__logo-image"
                loading="eager"
              >
            </a>
          </div>
        </div>
        
        <!-- Navigation (hidden on editor page) -->
        <nav class="hidden">
          <a href="/" class="header-nav-link">Home</a>
          <a href="/#pricing-cards" class="header-nav-link">Pricing</a>
          <a href="/#features" class="header-nav-link">Why Us</a>
          <a href="/#contact" class="header-nav-link">Contact</a>
        </nav>
        
        <!-- Cart Icon (hidden on editor page) -->
        <div class="hidden header__cart">
          <img
            src="{{ 'shopping_car.png' | asset_url }}"
            alt="Shopping Cart"
            class="header__cart-image"
            loading="eager"
          >
        </div>
      </div>
    </div>
  </header>

  <div class="editor-page" style="padding-top: 120px;">
    <div class="editor-container">
      <!-- Left side - Preview area -->
      <div class="editor-preview-section">
        <div class="preview-wrapper">
          <canvas id="tshirtCanvas"></canvas>
          <!-- Reset Rotation Button - positioned at top-left of preview area -->
          <button class="reset-rotation-btn" id="resetRotationBtn" style="display: none;">Reset Rotation</button>
          <div id="uploadOverlay" class="upload-overlay">
            <label for="imageUpload" class="upload-button">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
              </svg>
              Upload Your Design
            </label>
            <input type="file" id="imageUpload" accept="image/*" style="display: none;">
          </div>
        </div>
      </div>

      <!-- Right side - Controls -->
      <div class="editor-controls-section">
        <div class="price-display">
          <div class="price-amount" id="priceDisplay">
            <span class="price-value">$45.00</span>
            <span class="price-note">(Price per T-Shirt)</span>
          </div>
        </div>

        <!-- Print Size Selection -->
        <div class="control-group">
          <h3 class="control-title">Print Size</h3>
          <div class="print-size-buttons">
            <button class="print-size-btn" data-size="small">Small Logo</button>
            <button class="print-size-btn" data-size="standard">Standard Print</button>
            <button class="print-size-btn active" data-size="large">Large Print</button>
          </div>
        </div>

        <!-- Size Selection -->
        <div class="control-group">
          <div class="size-header">
            <h3 class="control-title">Size: <span id="selectedSize">L</span></h3>
            <button class="size-chart-btn" id="sizeChartBtn">Size Chart</button>
          </div>
          <div class="size-buttons">
            <button class="size-btn" data-size="S">S</button>
            <button class="size-btn" data-size="M">M</button>
            <button class="size-btn" data-size="L">L</button>
            <button class="size-btn" data-size="XL">XL</button>
            <button class="size-btn" data-size="2XL">2XL</button>
            <button class="size-btn" data-size="3XL">3XL</button>
          </div>
        </div>

        <!-- Color Selection -->
        <div class="control-group">
          <h3 class="control-title">Color: <span id="selectedColor">Black</span></h3>
          <div class="color-buttons">
            <button class="color-btn active" data-color="black">
              <div class="color-swatch black"></div>
            </button>
            <button class="color-btn" data-color="white">
              <div class="color-swatch white"></div>
            </button>
          </div>
        </div>

        <!-- Quantity Selector -->
        <div class="control-group">
          <h3 class="control-title">Quantity</h3>
          <div class="quantity-selector">
            <button id="decrementBtn" class="quantity-btn">-</button>
            <input type="number" id="quantityInput" class="quantity-input" value="1" min="1" max="100">
            <button id="incrementBtn" class="quantity-btn">+</button>
          </div>
        </div>

        <!-- Checkout Button -->
        <button class="checkout-btn" id="checkoutBtn">Checkout</button>
      </div>
    </div>
  </div>

  <!-- Size Chart Modal -->
  <div id="sizeChartModal" class="modal">
    <div class="modal-content">
      <span class="modal-close">&times;</span>
      <h2>T-Shirt Size Chart</h2>
      <img src="{{ 'editor-size-chart.png' | asset_url }}" alt="Size Chart">
    </div>
  </div>

  <!-- Upload Image Dialog -->
  <div id="uploadImageDialog" class="dialog">
    <div class="dialog-content">
      <div class="dialog-icon">📷</div>
      <h3 class="dialog-title">Please Upload an Image</h3>
      <p class="dialog-message">You need to upload an image before proceeding to checkout.</p>
      <button class="dialog-button" id="uploadImageDialogClose">OK</button>
    </div>
  </div>

  <script src="{{ 'editor.js' | asset_url }}" defer></script>
  <script>
    // Back button handler
    document.addEventListener('DOMContentLoaded', function() {
      const backButton = document.getElementById('backButton');
      if (backButton) {
        backButton.addEventListener('click', function() {
          window.location.href = '/';
        });
      }
    });
  </script>
</body>
</html>
