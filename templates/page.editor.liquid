{% layout none %}

<!-- Flutter Editor Page -->
<!-- This page loads the Flutter Web app from assets/editor/ -->
<!DOCTYPE html>
<html>
<head>
  {%- comment -%}
    IMPORTANT: Shopify assets directory is FLAT - no subdirectories allowed!
    All editor files must be directly in assets/ root directory.
    You need to:
    1. Copy all files from assets/editor/ to assets/ root
    2. Rebuild Flutter app with: flutter build web --base-href /assets/
    3. Then use the files directly without 'editor/' prefix
  {%- endcomment -%}
  {%- assign assets_base = 'flutter_bootstrap.js' | asset_url | split: 'flutter_bootstrap.js' | first -%}
  {%- comment -%} Remove query parameters {%- endcomment -%}
  {%- assign assets_base_clean = assets_base | split: '?' | first -%}
  <base href="{{ assets_base_clean }}">
  
  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="description" content="PrintOra T-Shirt Editor">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- iOS meta tags & icons -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="apple-mobile-web-app-title" content="PrintOra Editor">
  <link rel="apple-touch-icon" href="{{ 'Icon-192.png' | asset_url }}">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}"/>

  <title>PrintOra T-Shirt Editor</title>
  <link rel="manifest" href="{{ 'manifest.json' | asset_url }}">
  
  <script>
    // Preserve URL parameters for Flutter app
    (function() {
      // Get current URL parameters
      const urlParams = new URLSearchParams(window.location.search);
      const price = urlParams.get('price');
      const type = urlParams.get('type');
      
      // Store in sessionStorage for Flutter app to access
      if (price) {
        sessionStorage.setItem('editor_price', price);
      }
      if (type) {
        sessionStorage.setItem('editor_type', type);
      }
      
      // Debug: Check base href
      const baseElement = document.querySelector('base');
      if (baseElement) {
        console.log('Base href:', baseElement.href);
        // Ensure base href ends with '/'
        if (!baseElement.href.endsWith('/')) {
          baseElement.href = baseElement.href + '/';
          console.log('Fixed base href:', baseElement.href);
        }
      } else {
        console.error('Base element not found!');
      }
      
      // Error handling for script loading
      window.addEventListener('error', function(e) {
        console.error('Script loading error:', e.filename, e.message);
        if (e.filename && e.filename.includes('flutter_bootstrap')) {
          console.error('Flutter bootstrap failed to load. Check if the file exists at:', e.filename);
        }
      }, true);
    })();
  </script>
</head>
<body>
  <noscript>
    <div style="padding: 20px; text-align: center;">
      <h1>JavaScript Required</h1>
      <p>Please enable JavaScript to use the T-Shirt Editor.</p>
    </div>
  </noscript>
  
  <div id="loading" style="display: flex; justify-content: center; align-items: center; height: 100vh; font-family: Arial, sans-serif;">
    <div style="text-align: center;">
      <p>Loading editor...</p>
    </div>
  </div>
  
  <script>
    // Hide loading message when Flutter app loads
    window.addEventListener('flutter-first-frame', function() {
      const loading = document.getElementById('loading');
      if (loading) {
        loading.style.display = 'none';
      }
    });
    
    // Fallback: hide loading after 10 seconds
    setTimeout(function() {
      const loading = document.getElementById('loading');
      if (loading) {
        loading.style.display = 'none';
      }
    }, 10000);
  </script>
  
  {%- assign bootstrap_url = 'flutter_bootstrap.js' | asset_url -%}
  <script src="{{ bootstrap_url }}" async onerror="console.error('Failed to load flutter_bootstrap.js from:', this.src); document.getElementById('loading').innerHTML = '<div style=\'text-align: center; padding: 20px;\'><h1>Error Loading Editor</h1><p>Failed to load Flutter application.</p><p>Please check the browser console for details.</p></div>';"></script>
</body>
</html>
