{% layout none %}

<!-- Flutter Editor Page -->
<!-- This page loads the Flutter Web app from assets/editor/ -->
<!DOCTYPE html>
<html>
<head>
  {%- comment -%}
    Get the base URL for editor assets
    Shopify asset URLs are like: https://cdn.shopify.com/s/files/1/xxxxx/editor/
  {%- endcomment -%}
  {%- assign editor_base = 'editor/index.html' | asset_url | split: 'index.html' | first -%}
  <base href="{{ editor_base }}">
  
  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="description" content="PrintOra T-Shirt Editor">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- iOS meta tags & icons -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="apple-mobile-web-app-title" content="PrintOra Editor">
  <link rel="apple-touch-icon" href="{{ 'editor/icons/Icon-192.png' | asset_url }}">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="{{ 'editor/favicon.png' | asset_url }}"/>

  <title>PrintOra T-Shirt Editor</title>
  <link rel="manifest" href="{{ 'editor/manifest.json' | asset_url }}">
  
  {%- comment -%}
    Get URL parameters from query string
    Shopify provides request.query_string which contains the full query string
  {%- endcomment -%}
  {%- assign query_string = request.query_string -%}
  
  <script>
    // Preserve URL parameters for Flutter app
    // Flutter app will read these from window.location.search
    (function() {
      // Get current URL parameters
      const urlParams = new URLSearchParams(window.location.search);
      const price = urlParams.get('price');
      const type = urlParams.get('type');
      
      // Store in sessionStorage for Flutter app to access
      if (price) {
        sessionStorage.setItem('editor_price', price);
      }
      if (type) {
        sessionStorage.setItem('editor_type', type);
      }
      
      // Also update the base href to include query parameters if needed
      // The Flutter app should read from window.location.search
    })();
  </script>
</head>
<body>
  <script src="{{ 'editor/flutter_bootstrap.js' | asset_url }}" async></script>
</body>
</html>
